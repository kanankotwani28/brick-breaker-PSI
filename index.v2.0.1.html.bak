<script>const SPRITES={"ball": "data:image/png;base64,", "bolt": "data:image/png;base64,", "brick0": "data:image/png;base64,", "brick1": "data:image/png;base64,", "brick2": "data:image/png;base64,", "brick3": "data:image/png;base64,", "brick4": "data:image/png;base64,", "brick5": "data:image/png;base64,", "brickBonus": "data:image/png;base64,", "brickCracked0": "data:image/png;base64,", "brickCracked1": "data:image/png;base64,", "brickCracked2": "data:image/png;base64,", "brickCracked3": "data:image/png;base64,", "brickCracked4": "data:image/png;base64,", "brickCracked5": "data:image/png;base64,", "brickStone": "data:image/png;base64,", "heart": "data:image/png;base64,", "heartEmpty": "data:image/png;base64,", "paddle": "data:image/png;base64,", "pu0": "data:image/png;base64,", "pu1": "data:image/png;base64,", "pu2": "data:image/png;base64,", "pu3": "data:image/png;base64,", "pu4": "data:image/png;base64,", "starOff": "data:image/png;base64,", "starOn": "data:image/png;base64,", "icLockLight": "data:image/png;base64,", "rdMascot": "data:image/png;base64,", "rdMascotShadow": "data:image/png;base64,", "rdCoin": "data:image/png;base64,", "rdPill": "data:image/png;base64,", "rdStar": "data:image/png;base64,", "rdCrown": "data:image/png;base64,", "rdBall0": "data:image/png;base64,", "rdBall1": "data:image/png;base64,", "rdBall3": "data:image/png;base64,", "rdBall4": "data:image/png;base64,", "icBackLight": "data:image/png;base64,", "lcBtnRed": "data:image/png;base64,", "padWood": "data:image/png;base64,", "padWide": "data:image/png;base64,", "padSticky": "data:image/png;base64,", "padCannon": "data:image/png;base64,", "icPlay": "data:image/png;base64,"};</script>
<script>/* Menu redesign assets: clean landscape, UI sheet and logo,
   cut from the supplied mockup. nbLogo is split into JPEG colour +
   PNG alpha and recombined at boot - see recombineSplit(). */
Object.assign(SPRITES, {
  "nbBg": "data:image/jpeg;base64,",
  "nbPlay": "data:image/png;base64,",
  "nbLevels": "data:image/png;base64,",
  "nbShop": "data:image/png;base64,",
  "nbPlus": "data:image/png;base64,",
  "nbGear": "data:image/png;base64,",
  "nbCoin": "data:image/png;base64,",
  "nbCapS": "data:image/png;base64,",
  "nbCapL": "data:image/png;base64,",
  "nbLogo": "data:image/jpeg;base64,",
  "nbLogoA": "data:image/png;base64,"
});</script>
<script>/* Level Complete / in-play HUD assets, cut from the supplied
   sheets. The score capsule, lives capsule, progress bar and title
   ribbon had their live values painted in; those regions are blanked
   so the game draws the real value over them. */
Object.assign(SPRITES, {
  "lvBtnBlue": "data:image/png;base64,",
  "lvBtnGreen": "data:image/png;base64,",
  "lvBtnGold": "data:image/png;base64,",
  "lvIcMap": "data:image/png;base64,",
  "lvIcReplay": "data:image/png;base64,",
  "lvIcNext": "data:image/png;base64,",
  "lvIcStar": "data:image/png;base64,",
  "lvIcCoin": "data:image/png;base64,",
  "lvIcTrophy": "data:image/png;base64,",
  "lvIcCrown": "data:image/png;base64,",
  "lvStar": "data:image/png;base64,",
  "lvPause": "data:image/png;base64,",
  "lvStarOff": "data:image/png;base64,",
  "lvRibbon": "data:image/png;base64,",
  "lvProg": "data:image/png;base64,",
  "lvScoreCap": "data:image/png;base64,",
  "lvLivesCap": "data:image/png;base64,",
  "lvPanel": "data:image/png;base64,",
  "lvBox": "data:image/png;base64,"
});</script>
<script>/* Per-level background paintings. bgTexture() picks up
   lvbg<N> automatically and falls back to the procedural
   generator for any level without one. */
Object.assign(SPRITES, {
  "lvbg1": "data:image/jpeg;base64,",
  "lvbg2": "data:image/jpeg;base64,",
  "lvbg3": "data:image/jpeg;base64,",
  "lvbg4": "data:image/jpeg;base64,",
  "lvbg5": "data:image/jpeg;base64,",
  "lvbg6": "data:image/jpeg;base64,",
  "lvbg7": "data:image/jpeg;base64,",
  "lvbg8": "data:image/jpeg;base64,",
  "lvbg9": "data:image/jpeg;base64,",
  "lvbg10": "data:image/jpeg;base64,",
  "lvbg11": "data:image/jpeg;base64,",
  "lvbg12": "data:image/jpeg;base64,",
  "lvbg13": "data:image/jpeg;base64,"
});</script>
<script>
/* =====================================================================
   BACKGROUNDS — procedural, resolution-independent.

   Renders any of the 25 level backdrops into a canvas at ANY size, so a
   1440p phone gets 1440p art and a 720p phone gets 720p art. Nothing is
   upscaled, because nothing is a bitmap.

   Palettes (PAL) were sampled from the 25 reference paintings, so each
   level keeps its own identity: sky ramp + signature accent colour.
   BIOME picks which shapes get drawn on top of that ramp.

   Cost: ~8 KB of code and ~4 KB of palette data, versus 1.9 MB of PNG.
   ===================================================================== */

/* deterministic RNG so a level looks identical every time it loads */
function rng(seed) {
  let s = seed >>> 0 || 1;
  return function () {
    s ^= s << 13; s >>>= 0;
    s ^= s >> 17;
    s ^= s << 5;  s >>>= 0;
    return s / 4294967296;
  };
}

const BIOME = [
  'meadow','night','volcanic','meadow','forest',
  'water','forest','volcanic','meadow','forest',
  'desert','night','volcanic','meadow','forest',
  'desert','snow','volcanic','meadow','forest',
  'desert','night','volcanic','meadow','forest',
];

/* sampled from the reference art — see palettes.json */
const PAL = [{"ramp": ["#6ba8e4", "#78beeb", "#80caee", "#9eddf0", "#a8e3ef", "#799a79"], "accent": "#69a3e1"}, {"ramp": ["#223261", "#253b7a", "#27458c", "#3351a1", "#263b7e", "#1f4372"], "accent": "#1a3d77"}, {"ramp": ["#9e5d6d", "#c06a63", "#df8358", "#ea9855", "#c68f5c", "#764c5a"], "accent": "#ee9852"}, {"ramp": ["#69a6e3", "#74bbeb", "#79c6ee", "#8cd2f0", "#91c3c9", "#79a472"], "accent": "#285a68"}, {"ramp": ["#2a5c69", "#326f76", "#58a9b2", "#6cbabc", "#428587", "#3b7861"], "accent": "#245967"}, {"ramp": ["#558a4c", "#3cb4bd", "#33abc4", "#2ea5c9", "#2ca1c9", "#2772b0"], "accent": "#2480bc"}, {"ramp": ["#1c5361", "#6b95c9", "#688ac2", "#849ecd", "#a2c2e6", "#85a6cf"], "accent": "#194d5c"}, {"ramp": ["#593245", "#6a6ab0", "#726fbc", "#8b7ec6", "#a58ac8", "#9581aa"], "accent": "#5b3344"}, {"ramp": ["#4c7f54", "#64a6a9", "#67adb1", "#74bcba", "#89cac1", "#72a69e"], "accent": "#25625a"}, {"ramp": ["#2e6448", "#316c6b", "#2c6a64", "#4d8e7a", "#58a290", "#3e7f5e"], "accent": "#205d5d"}, {"ramp": ["#1f588c", "#226a7f", "#8ab8ae", "#90bcb1", "#b0c9b3", "#c9d2b2"], "accent": "#1a5d9c"}, {"ramp": ["#6f99bd", "#618da8", "#443b74", "#363581", "#3e398f", "#4a4184"], "accent": "#1f2962"}, {"ramp": ["#473869", "#4c3654", "#6a4358", "#774356", "#8f4752", "#7c474c"], "accent": "#a6504c"}, {"ramp": ["#749561", "#588561", "#67a0de", "#68a5e3", "#74b3e9", "#93bbea"], "accent": "#1e585f"}, {"ramp": ["#396347", "#2a5b44", "#21585e", "#1d5f60", "#247974", "#40a396"], "accent": "#197071"}, {"ramp": ["#b88350", "#d68d45", "#93623f", "#c0997c", "#d1a57f", "#d7ae80"], "accent": "#e19142"}, {"ramp": ["#292f6f", "#393a7d", "#2d3168", "#5dabdf", "#68b2e5", "#77b1d9"], "accent": "#1d2962"}, {"ramp": ["#76363a", "#693b42", "#4c2c3d", "#583f58", "#6e3e4f", "#7f3943"], "accent": "#cf4b32"}, {"ramp": ["#7d989b", "#7f9775", "#557e67", "#5999dc", "#669d9d", "#607ca1"], "accent": "#19524f"}, {"ramp": ["#247163", "#2b7051", "#1d5249", "#205852", "#1c655f", "#1e7c70"], "accent": "#166d67"}, {"ramp": ["#a77d54", "#866249", "#6eafdb", "#8abed0", "#a5997e", "#8ba481"], "accent": "#64a2d3"}, {"ramp": ["#6491b0", "#517fa1", "#466caf", "#5a8bcc", "#435c86", "#4375af"], "accent": "#296bb8"}, {"ramp": ["#683740", "#583040", "#655559", "#7c5e58", "#704f43", "#6b4440"], "accent": "#a4433a"}, {"ramp": ["#67885f", "#4f7a5d", "#396b76", "#5d7675", "#577a79", "#718571"], "accent": "#2b5f6e"}, {"ramp": ["#246d47", "#225043", "#8b55a0", "#6b3e88", "#7a6ec2", "#574b73"], "accent": "#1d725a"}];

/* ---------- colour helpers ---------- */
function hex2rgb(h) {
  return [parseInt(h.slice(1,3),16), parseInt(h.slice(3,5),16), parseInt(h.slice(5,7),16)];
}
function mix(a, b, t) {
  const A = hex2rgb(a), B = hex2rgb(b);
  return `rgb(${Math.round(A[0]+(B[0]-A[0])*t)},${Math.round(A[1]+(B[1]-A[1])*t)},${Math.round(A[2]+(B[2]-A[2])*t)})`;
}
function shade(h, t) {           // t<0 darken, t>0 lighten
  const c = hex2rgb(h);
  const f = (v) => Math.max(0, Math.min(255, Math.round(t < 0 ? v*(1+t) : v+(255-v)*t)));
  return `rgb(${f(c[0])},${f(c[1])},${f(c[2])})`;
}
function rgba(h, a) {
  const c = hex2rgb(h);
  return `rgba(${c[0]},${c[1]},${c[2]},${a})`;
}

/* ---------- shape primitives ---------- */

/* A rolling silhouette band — used for hills, dunes, treelines, ridges.
   `jag` controls how spiky it is: 0 = smooth dunes, 1 = jagged peaks. */
function ridgeBand(ctx, W, H, baseY, amp, jag, fill, rand, steps) {
  steps = steps || 9;
  ctx.beginPath();
  ctx.moveTo(0, H);
  ctx.lineTo(0, baseY);
  const pts = [];
  for (let i = 0; i <= steps; i++) {
    /* Bias every other point higher so peaks and saddles alternate; pure
       random per point averages out into a flat, uninteresting band. */
    const bias = (i % 2 === 0) ? 0.55 : 0.15;
    const t = bias + rand() * 0.45;
    pts.push({ x: (i / steps) * W, y: baseY - t * amp * (jag > .5 ? 1 : .7) });
  }
  for (let i = 0; i < pts.length - 1; i++) {
    const p = pts[i], n = pts[i + 1];
    if (jag > 0.5) {
      ctx.lineTo(p.x, p.y); ctx.lineTo((p.x+n.x)/2, Math.min(p.y,n.y) - amp*0.35*rand());
    } else {
      const cx = (p.x + n.x) / 2;
      ctx.quadraticCurveTo(cx, p.y, cx, (p.y + n.y) / 2);
      ctx.quadraticCurveTo(cx, n.y, n.x, n.y);
    }
  }
  ctx.lineTo(W, baseY); ctx.lineTo(W, H); ctx.closePath();
  ctx.fillStyle = fill; ctx.fill();
}

/* A row of conifer/canopy silhouettes */
function treeLine(ctx, W, H, baseY, treeH, fill, rand, count) {
  ctx.fillStyle = fill;
  for (let i = 0; i < count; i++) {
    const x = (i / (count - 1)) * W + (rand() - .5) * (W / count) * .6;
    const h = treeH * (0.62 + rand() * 0.55);
    const w = h * (0.36 + rand() * 0.18);
    ctx.beginPath();
    ctx.moveTo(x, baseY - h);
    ctx.lineTo(x + w / 2, baseY + h * .06);
    ctx.lineTo(x - w / 2, baseY + h * .06);
    ctx.closePath(); ctx.fill();
    // trunk
    ctx.fillRect(x - w * .05, baseY, w * .1, h * .14);
  }
}

/* A cumulus cloud: rolling top, flat base.

   The previous version stacked five same-sized circles, which read as a
   bunch of grapes - each lobe was individually legible and the silhouette
   had no direction. Three things fix that:

     1. ONE path, filled once. Separate arc+fill calls at partial alpha
        show their overlaps as darker seams, which is what makes lobes
        pop out as discrete bubbles.
     2. Ellipses wider than tall (the `2.1` aspect below), so lobes read
        as part of a horizontal mass rather than as circles.
     3. A sine envelope over the lobe heights plus a slab along the
        bottom, giving the flat base and domed top real clouds have.
*/
function cloud(ctx, cx, cy, w, h, fill, alpha, rand) {
  const r = rand || Math.random;

  /* A smooth sine envelope produces a perfect dome, which reads as a
     loaf or a hill rather than a cloud. Two things break that up:
     an OFF-CENTRE peak, and lobe heights that step irregularly instead
     of tracing the curve exactly. */
  const peak = 0.34 + r() * 0.30;        // where the tallest lobe sits
  const n = 7;
  const baseY = cy + h * 0.34;           // flat underside

  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.fillStyle = fill;

  /* One path filled once. Filling each lobe separately at partial alpha
     makes every overlap a darker seam, which is exactly what makes the
     lobes pop out as discrete bubbles. */
  ctx.beginPath();
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1);
    // asymmetric falloff either side of the peak
    const d = t < peak ? (t / peak) : (1 - t) / (1 - peak);
    const env = Math.pow(Math.max(0, d), 0.75);
    const jitter = 0.62 + r() * 0.62;    // wide, so the top edge steps
    const rh = h * (0.14 + 0.86 * env) * jitter * 0.5;
    const rw = rh * (1.5 + r() * 0.7);   // wider than tall, and unequal
    ctx.ellipse(cx - w / 2 + w * t, baseY - rh * 0.88, rw, rh, 0, 0, Math.PI * 2);
  }
  // slab tying the lobes into one mass and holding the base flat
  ctx.ellipse(cx, baseY - h * 0.12, w * 0.46, h * 0.17, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

/* Grass tufts along the ground line */
function grassLine(ctx, W, baseY, h, fill, rand, count) {
  ctx.fillStyle = fill;
  for (let i = 0; i < count; i++) {
    const x = rand() * W, hh = h * (0.5 + rand());
    ctx.beginPath();
    ctx.moveTo(x, baseY);
    ctx.quadraticCurveTo(x + hh*0.28, baseY - hh*0.6, x + hh*0.1, baseY - hh);
    ctx.quadraticCurveTo(x + hh*0.02, baseY - hh*0.5, x - hh*0.12, baseY);
    ctx.closePath(); ctx.fill();
  }
}

/* ---------- main renderer ---------- */
/**
 * @param {HTMLCanvasElement} canvas  target (its width/height set the resolution)
 * @param {number} level  0..24
 */
function renderBackground(canvas, level) {
  const W = canvas.width, H = canvas.height;
  const ctx = canvas.getContext('2d');
  const p = PAL[level % PAL.length];
  const biome = BIOME[level % BIOME.length];
  const rand = rng(level * 7919 + 13);
  const A = p.accent;

  /* --- sky: the sampled vertical ramp. A gradient is pure maths, so this
         layer alone is already perfectly sharp at any resolution. --- */
  const g = ctx.createLinearGradient(0, 0, 0, H);
  p.ramp.forEach((c, i) => g.addColorStop(i / (p.ramp.length - 1), c));
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

  const horizon = H * 0.70;

  /* --- celestial --- */
  if (biome === 'night') {
    for (let i = 0; i < 90; i++) {
      const x = rand()*W, y = rand()*horizon*0.9, r = rand()*W*0.0022 + W*0.0007;
      ctx.globalAlpha = 0.35 + rand()*0.65;
      ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
    const mx = W*0.70, my = H*0.13, mr = W*0.085;
    const mg = ctx.createRadialGradient(mx,my,0,mx,my,mr*3.4);
    mg.addColorStop(0, 'rgba(255,255,235,0.42)'); mg.addColorStop(1, 'rgba(255,255,235,0)');
    ctx.fillStyle = mg; ctx.beginPath(); ctx.arc(mx,my,mr*3.4,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = '#F6F3DE'; ctx.beginPath(); ctx.arc(mx,my,mr,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = rgba(p.ramp[1], 0.16);
    ctx.beginPath(); ctx.arc(mx - mr*0.3, my - mr*0.25, mr*0.20, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(mx + mr*0.32, my + mr*0.20, mr*0.14, 0, Math.PI*2); ctx.fill();
  } else if (biome === 'meadow' || biome === 'desert') {
    const sx = W*0.5, sy = H*0.20, sr = W*0.10;
    const sg = ctx.createRadialGradient(sx,sy,0,sx,sy,sr*3.2);
    sg.addColorStop(0, 'rgba(255,248,205,0.60)'); sg.addColorStop(1, 'rgba(255,248,205,0)');
    ctx.fillStyle = sg; ctx.beginPath(); ctx.arc(sx,sy,sr*3.2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = 'rgba(255,250,214,0.92)';
    ctx.beginPath(); ctx.arc(sx,sy,sr*0.62,0,Math.PI*2); ctx.fill();
  } else if (biome === 'volcanic') {
    const sg = ctx.createRadialGradient(W*0.5, H*0.62, 0, W*0.5, H*0.62, W*0.85);
    sg.addColorStop(0, rgba(A, 0.55)); sg.addColorStop(1, rgba(A, 0));
    ctx.fillStyle = sg; ctx.fillRect(0,0,W,H);
  }
  ctx.globalAlpha = 1;

  /* --- clouds --- */
  if (biome === 'meadow' || biome === 'desert' || biome === 'snow' || biome === 'night') {
    const n = biome === 'night' ? 3 : 5;
    const tint = biome === 'night' ? shade(p.ramp[2], 0.34) : '#ffffff';
    /* Spread across bands rather than at pure random x/y: random draws
       clump often enough that a third of levels ended up with every cloud
       piled in one corner.

       Size matters more than shape here. At 30-52% of screen width these
       filled the sky and became the subject of the frame; clouds are
       backdrop, and the bricks have to stay the thing you look at. */
    for (let i = 0; i < n; i++) {
      const band = (i + 0.5) / n;
      const cx = W * (band + (rand() - 0.5) * 0.30);
      const cy = H * (0.05 + rand() * 0.22);
      const cw = W * (0.15 + rand() * 0.11);
      const ch = cw * (0.30 + rand() * 0.10);
      const a  = biome === 'night' ? 0.16 : 0.24 + rand() * 0.16;
      cloud(ctx, cx, cy, cw, ch, tint, a, rand);
    }
  }

  /* --- distant layer --- */
  const far = shade(p.ramp[3], -0.30);
  if (biome === 'volcanic') {
    const ry = horizon*0.80;
    ridgeBand(ctx, W, H, ry, H*0.16, 0.9, shade(p.ramp[1], -0.40), rand, 7);
    /* Glow sits BEHIND/BELOW the ridge as a soft bloom, not as a drawn line.
       A filled rect here reads as a rendering artifact - it cuts the full
       width at a constant y regardless of where the rock actually is. */
    const lg = ctx.createRadialGradient(W*0.5, ry + H*0.02, 0, W*0.5, ry + H*0.02, W*0.62);
    lg.addColorStop(0, rgba(A, 0.42));
    lg.addColorStop(0.45, rgba(A, 0.14));
    lg.addColorStop(1, rgba(A, 0));
    ctx.fillStyle = lg; ctx.fillRect(0, ry - H*0.10, W, H*0.34);
  } else if (biome === 'desert') {
    ridgeBand(ctx, W, H, horizon*0.86, H*0.09, 0.2, shade(p.ramp[3], -0.16), rand, 6);
  } else if (biome === 'snow') {
    ridgeBand(ctx, W, H, horizon*0.78, H*0.15, 0.85, shade(p.ramp[2], -0.12), rand, 6);
  } else if (biome === 'forest') {
    treeLine(ctx, W, H, horizon*0.92, H*0.20, shade(p.ramp[2], -0.32), rand, 14);
  } else if (biome === 'water') {
    ridgeBand(ctx, W, H, horizon*0.88, H*0.07, 0.3, shade(p.ramp[2], -0.22), rand, 7);
  } else {
    ridgeBand(ctx, W, H, horizon*0.88, H*0.08, 0.35, far, rand, 7);
  }

  /* --- mid layer --- */
  if (biome === 'forest') {
    treeLine(ctx, W, H, horizon*1.02, H*0.26, shade(p.ramp[4], -0.48), rand, 10);
  } else if (biome === 'volcanic') {
    ridgeBand(ctx, W, H, horizon*0.96, H*0.12, 0.95, shade(p.ramp[0], -0.55), rand, 6);
  } else {
    ridgeBand(ctx, W, H, horizon*0.97, H*0.06, 0.3, shade(p.ramp[4], -0.30), rand, 8);
  }

  /* --- ground --- */
  const gg = ctx.createLinearGradient(0, horizon, 0, H);
  gg.addColorStop(0, shade(p.ramp[5], 0.06));
  gg.addColorStop(1, shade(p.ramp[5], -0.34));
  ctx.fillStyle = gg;
  ctx.beginPath();
  ctx.moveTo(0, horizon + H*0.012);
  ctx.quadraticCurveTo(W*0.5, horizon - H*0.014, W, horizon + H*0.012);
  ctx.lineTo(W, H); ctx.lineTo(0, H); ctx.closePath(); ctx.fill();

  if (biome === 'meadow' || biome === 'forest') {
    grassLine(ctx, W, horizon + H*0.016, H*0.028, shade(p.ramp[5], 0.22), rand, 46);
  }

  /* --- ambient particles --- */
  const parts = { volcanic:'ember', forest:'fly', night:'fly', water:'bubble', snow:'flake' }[biome];
  if (parts) {
    for (let i = 0; i < 34; i++) {
      const x = rand()*W, y = rand()*H*0.9, r = W*(0.0022 + rand()*0.0038);
      ctx.globalAlpha = 0.20 + rand()*0.50;
      ctx.fillStyle = parts === 'ember' ? A
                    : parts === 'fly'   ? shade(A, 0.55)
                    : parts === 'bubble'? 'rgba(255,255,255,0.9)'
                    : '#ffffff';
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  /* --- vignette + top scrim so HUD text stays legible --- */
  const vg = ctx.createRadialGradient(W*0.5, H*0.42, H*0.20, W*0.5, H*0.5, H*0.78);
  vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,0.34)');
  ctx.fillStyle = vg; ctx.fillRect(0,0,W,H);

  const tg = ctx.createLinearGradient(0, 0, 0, H*0.20);
  tg.addColorStop(0, 'rgba(6,14,22,0.40)'); tg.addColorStop(1, 'rgba(6,14,22,0)');
  ctx.fillStyle = tg; ctx.fillRect(0, 0, W, H*0.20);

  return canvas;
}

/* Phaser helper: bake a background into a texture at the world size. */
function installBackgroundTexture(scene, level, w, h) {
  const key = 'bg_' + level;
  if (scene.textures.exists(key)) return key;
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  renderBackground(c, level);
  scene.textures.addCanvas(key, c);
  return key;
}

</script>
<script>
/* =====================================================================
   BRICK BREAKER — CORE (v2)

   Replaces the LEVELS / RUN / SAVE block of the original single-file
   build. Everything here is engine-agnostic plain JS; the Phaser scenes
   import from it.

   What changed from v1:
     - 5 levels  -> 25 levels, grouped into 5 tiers of 5
     - flat ball speed -> per-level speed curve (520 -> 1080)
     - stars were cosmetic -> stars now GATE tier unlocks
     - new: coins, earned in play, spent in the shop
     - new: owned/equipped cosmetics with gameplay modifiers
     - save schema v1 -> v2, with migration (v1 progress is preserved)
   ===================================================================== */

'use strict';

/* ------------------------------------------------------------------
   TIERS — 5 bands of 5 levels.

   A tier is gated on STARS, not on finishing the previous level. This
   is deliberate: it means a player who scrapes through every level on
   1 star eventually hits a wall and has to go back and improve an
   earlier level, instead of being carried to level 25 on bare passes.
   ------------------------------------------------------------------ */
const TIERS = [
  { name: 'MEADOW', colour: 0x5EA832, dark: 0x3C7A1C, starGate: 0  },
  { name: 'HOLLOW', colour: 0x3D86C4, dark: 0x255F94, starGate: 8  },
  { name: 'EMBER',  colour: 0xE08A2A, dark: 0xA85F12, starGate: 20 },
  { name: 'DUST',   colour: 0xC1543C, dark: 0x8E3423, starGate: 33 },
  { name: 'HEART',  colour: 0x8B5BC4, dark: 0x5F3690, starGate: 47 },
];
const LEVEL_COUNT = 25;
const MAX_STARS = LEVEL_COUNT * 3;          // 75
const tierOf = (i) => Math.min(4, Math.floor(i / 5));

/* ------------------------------------------------------------------
   DIFFICULTY

   Ball speed is the primary knob. The 0.85 exponent front-loads the
   ramp: a linear curve makes levels 1-6 feel identical, because a 23
   px/s step is imperceptible. Front-loading gives early levels a
   noticeable step up while keeping the top end from becoming
   unplayable.

   BALL_MAX is the ceiling enforced in onPaddleHit - it has to scale
   with the launch speed or the paddle's 1.2% per-hit acceleration gets
   clamped away instantly on late levels.
   ------------------------------------------------------------------ */
const SPEED_MIN = 520, SPEED_MAX = 1080;
function speedFor(i) {
  return Math.round(SPEED_MIN + (SPEED_MAX - SPEED_MIN) * Math.pow(i / (LEVEL_COUNT - 1), 0.85));
}
function speedCapFor(i) { return Math.round(speedFor(i) * 1.34); }

/* Paddle shrinks slightly across the run - a second difficulty axis so
   late levels aren't only "the ball is fast now". Floor at 78% so it
   never becomes unfair. */
function paddleScaleFor(i) {
  return Math.max(0.78, 1 - (i / (LEVEL_COUNT - 1)) * 0.22);
}

/* Power-up drop rate falls as levels get harder, so late levels are not
   trivially rescued by a lucky multi-ball. */
function dropChanceFor(i) {
  return 0.17 - (i / (LEVEL_COUNT - 1)) * 0.05;   // .17 -> .12
}

/* ------------------------------------------------------------------
   ECONOMY — two currencies, deliberately.

   STARS  : performance. 1-3 per level, best-ever kept. Gate tiers.
            Capped at 75, so they cannot be farmed.
   COINS  : volume. Earned per brick and per level clear. Unbounded, so
            they can price a shop without the prices having to fit
            inside a 75-point budget.

   Trying to make stars do both jobs is what broke the first draft: the
   shop wanted ~890 currency against a 75-star lifetime ceiling. Splitting
   them lets stars stay a tight skill signal while coins scale with time
   played.
   ------------------------------------------------------------------ */
const COIN_PER_BRICK = 2;
const COIN_PER_BONUS_BRICK = 6;
const COIN_LEVEL_CLEAR = 25;
const COIN_PER_STAR = 15;        // paid once, on first time earning each star

/* ------------------------------------------------------------------
   LEVELS
   1-6 = coloured brick   D = 2-hit   S = unbreakable   B = bonus   . = gap
   ------------------------------------------------------------------ */
const LEVEL_DATA = [
  { name: "THE STONE CIRCLE", rows: ["123321", "2....2", "3.55.3", "D.66.D", "56..65"] },
  { name: "MOONLIT HOLLOW", rows: ["23456.", "B.5612", "456123", "D612.4", "...34B"] },
  { name: "EMBER CLEARING", rows: ["34...2", "....23", "5...B4", "6.2345", "12B456"] },
  { name: "THE RUNESTONE", rows: ["B5665B", "561165", "612216", "1.33.1", "......"] },
  { name: "THE DEEP WOOD", rows: ["D61D34", "B12.S.", "12B45.", "23.561", "3.5D12"] },
  { name: "SUNKEN ARCH", rows: ["SD2345", "B2D45D", "234561", "34S612", "D5.1SD"] },
  { name: "SILVER THICKET", rows: ["1.33.1", "B3443B", ".BDDB.", "B.66.B", "561165"] },
  { name: "CINDER RIDGE", rows: ["SSD5D1", "3.5612", "45D.23", "B6D.3.", "6.234D", "1.D456"] },
  { name: "GLYPHS OF MOSS", rows: ["345DB2", "45612B", "5...3S", "S12.45", "D23B56", ".S4561"] },
  { name: "TANGLEROOT", rows: ["456654", ".D11D.", "6.22.6", "1D33D1", "DD44DD", "D4..4D"] },
  { name: "DUNE MARCH", rows: ["56D2D4", "6123SD", "1234D6", "D345D1", "34D612", "BDDDDB"] },
  { name: "NIGHTFALL PATH", rows: ["S1D3B.", "12D456", "234S61", ".45.12", "4B612D", "DSB23."] },
  { name: "THE ASH GATE", rows: ["DDDDDD", "2BBBB2", "DD..DD", "456654", "5D11D5", "D1221D"] },
  { name: "THE QUIET STONE", rows: ["DDS56S", ".D5S1S", "D5D1B.", "561BS4", "6D23SB", "B2345B"] },
  { name: "HOLLOW CANOPY", rows: ["34D6D2", "4D6D23", "5SD.DS", ".D23DS", "123D..", "2S4.BS", "DD561S"] },
  { name: "PILLARS OF DUST", rows: ["4B66B4", "B6SS6B", "DSBBSD", "SDDDDS", "2.DD.2", "345543", "BB..BB"] },
  { name: "THE PALE WATCH", rows: ["D61D34", "6DDDS5", "SDDB56", ".D4SS1", "3D56SD", "4.D123", ".61S.D"] },
  { name: "EMBERFALL", rows: ["SS23D5", "123SD6", "DS4.6D", "D4D6SD", "S5.DDS", "5DDSDD", "S1S.4D"] },
  { name: "RUNEWARD", rows: ["123321", "DDBBDD", "3D55D3", "D5665D", "5DDDD5", "DS22SD", "1.DD.1"] },
  { name: "THE GREEN DARK", rows: [".BD5SB", "SB56DS", "DS61S3", "5D12B.", "DS.3SD", ".2D.S6", "D345D1"] },
  { name: "THE LAST OASIS", rows: ["3DS6SS", "DD6D2.", "5DSDDB", "S1DD4S", "1BDDSS", "BDS.DD", "SD5.DS"] },
  { name: "MOONSHADOW", rows: ["4DBBD4", "DD11DD", "D1..1D", "SD33DS", "DS44SD", "3SDDS3", "DD..DD", "S6DD6S"] },
  { name: "THE FORGE ROAD", rows: ["DDDSDS", "D12S.D", "1.SDDS", "2.4S61", "3BD6DD", "DD6DD3", "56SS34", ".1SBD5"] },
  { name: "THE SEALED MARK", rows: ["D1S3SD", "1B3SDD", "BDB.S1", "SD5.1B", "SSSS.3", "D61DD.", "S12DDD", "1DDS56"] },
  { name: "HEARTWOOD", rows: ["12BB21", "DDDDDD", "3SDDS3", "SD66DS", ".D11D.", "SSBBSS", "12SS21", "D3DD3D"] }
];
const LEVELS = LEVEL_DATA;

/* ------------------------------------------------------------------
   SHOP
   `mod` is applied at runtime by the Play scene. Keep every modifier
   small: these are cosmetics with a nudge, not a difficulty bypass.
   ------------------------------------------------------------------ */
const SHOP = {
  ball: [
    /* art is a BALL for every ball, the way it is a paddle for every
       paddle. These previously reused the power-up pickup icons, so the
       shop showed a flame and a magnet where the player expected to see
       what their ball would look like. */
    { id: 'classic', name: 'CLASSIC', desc: 'The one you start with.',       price: 0,   art: 'rdBall0', mod: {} },
    { id: 'ember',   name: 'EMBER',   desc: 'Cracked bricks break in one.',  price: 300, art: 'rdBall4',   mod: { crackThrough: true } },
    { id: 'magnet',  name: 'MAGNET',  desc: 'Curves gently toward bricks.',  price: 650, art: 'rdBall1',  mod: { homing: 0.16 } },
    { id: 'bolt',    name: 'BOLT',    desc: '+10% score, +8% ball speed.',   price: 1100,art: 'rdBall3',    mod: { scoreMul: 1.10, speedMul: 1.08 } },
  ],
  paddle: [
    { id: 'wood',    name: 'WOOD',    desc: 'Standard width and grip.',      price: 0,   art: 'padWood',    mod: {} },
    { id: 'wide',    name: 'WIDE',    desc: '+14% width, permanently.',      price: 450, art: 'padWide',    mod: { widthMul: 1.14 } },
    { id: 'sticky',  name: 'STICKY',  desc: 'Catch and re-aim once a life.', price: 800, art: 'padSticky',  mod: { sticky: 1 } },
    { id: 'cannon',  name: 'CANNON',  desc: 'Auto-fires every 7 seconds.',   price: 1400,art: 'padCannon',  mod: { autoFire: 7 } },
  ],
};
function shopItem(kind, id) { return SHOP[kind].find((s) => s.id === id) || SHOP[kind][0]; }

/* ------------------------------------------------------------------
   SAVE v2

   Same defensive shape as v1 - every storage touch wrapped, in-memory
   fallback when localStorage throws - plus a migration path so an
   existing v1 player does not lose progress on update.
   ------------------------------------------------------------------ */
const SAVE = (function () {
  const KEY = 'brickbreaker.v2';
  const OLD_KEY = 'adverb.brickbreaker.v1';

  function blank() {
    return {
      v: 2,
      stars: {},              // { levelIndex: 0..3 }
      bestScore: 0,
      coins: 0,
      owned: { ball: ['classic'], paddle: ['wood'] },
      equipped: { ball: 'classic', paddle: 'wood' },
      paidStars: 0,           // stars already converted to coins
    };
  }

  let mem = null;

  /* v1 stored { unlocked, bestScore, stars }. Stars carry over directly;
     `unlocked` is dropped because unlocking is now derived from stars. */
  function migrate() {
    try {
      const raw = window.localStorage.getItem(OLD_KEY);
      if (!raw) return null;
      const old = JSON.parse(raw);
      const d = blank();
      if (old.stars && typeof old.stars === 'object') d.stars = Object.assign({}, old.stars);
      d.bestScore = old.bestScore || 0;
      // grandfather in coins for stars already earned, so an existing
      // player opens the new shop with something to spend
      const s = Object.keys(d.stars).reduce((n, k) => n + (d.stars[k] || 0), 0);
      d.coins = s * COIN_PER_STAR;
      d.paidStars = s;
      return d;
    } catch (e) { return null; }
  }

  function read() {
    if (mem) return mem;
    try {
      const raw = window.localStorage.getItem(KEY);
      if (raw) {
        mem = Object.assign(blank(), JSON.parse(raw));
      } else {
        mem = migrate() || blank();
        write();
      }
    } catch (e) {
      mem = blank();
    }
    // defensive: a hand-edited or partially-written save must not crash the game
    if (!mem.stars || typeof mem.stars !== 'object') mem.stars = {};
    if (!mem.owned) mem.owned = { ball: ['classic'], paddle: ['wood'] };
    if (!mem.owned.ball || !mem.owned.ball.length) mem.owned.ball = ['classic'];
    if (!mem.owned.paddle || !mem.owned.paddle.length) mem.owned.paddle = ['wood'];
    if (!mem.equipped) mem.equipped = { ball: 'classic', paddle: 'wood' };
    if (typeof mem.coins !== 'number' || mem.coins < 0) mem.coins = 0;
    return mem;
  }

  function write() {
    try { window.localStorage.setItem(KEY, JSON.stringify(mem)); } catch (e) { /* in-memory only */ }
  }

  return {
    get data() { return read(); },

    totalStars() {
      const d = read();
      return Object.keys(d.stars).reduce((n, k) => n + (d.stars[k] || 0), 0);
    },
    starsFor(i) { return read().stars[i] || 0; },
    bestScore()  { return read().bestScore; },
    coins()      { return read().coins; },

    /* A level is playable if its tier's star gate is met AND the previous
       level has been cleared (or it's the first of an open tier). */
    isUnlocked(i) {
      if (i === 0) return true;
      const d = read();
      if (this.totalStars() < TIERS[tierOf(i)].starGate) return false;
      if (i % 5 === 0) return true;            // first level of an open tier
      return (d.stars[i - 1] || 0) > 0;
    },
    /* Highest level the player can enter — used for the PLAY button. */
    nextLevel() {
      for (let i = 0; i < LEVEL_COUNT; i++) {
        if (this.isUnlocked(i) && !(read().stars[i] > 0)) return i;
      }
      return LEVEL_COUNT - 1;
    },
    gateFor(i) { return TIERS[tierOf(i)].starGate; },

    /* Record a finished level. Only ever improves a stored value.

       Star coins are paid ONCE per star ever earned (paidStars), so a replay
       cannot re-sell a star the player already holds. Brick coins and the
       clear bonus DO pay again on every clear - deliberate, since that is the
       only repeatable income in the game and it is what lets a stuck player
       grind toward a shop item. It does mean the shop is farmable: level 1
       pays 65 a clear against a 4,700 total, so ~72 replays buys everything.
       Damp repeat clears here if that ever needs tightening. */
    completeLevel(index, stars, score, coinsEarned) {
      const d = read();
      const prev = d.stars[index] || 0;
      d.stars[index] = Math.max(prev, stars);
      if (score > d.bestScore) d.bestScore = score;
      d.coins += (coinsEarned || 0) + COIN_LEVEL_CLEAR;
      const total = this.totalStars();
      if (total > d.paidStars) {
        d.coins += (total - d.paidStars) * COIN_PER_STAR;
        d.paidStars = total;
      }
      write();
      return { newStars: Math.max(0, d.stars[index] - prev) };
    },

    addCoins(n) { const d = read(); d.coins = Math.max(0, d.coins + n); write(); },

    owns(kind, id) { return read().owned[kind].indexOf(id) >= 0; },
    equippedId(kind) { return read().equipped[kind]; },
    /** @returns {boolean} true if the purchase went through */
    buy(kind, id) {
      const d = read();
      const it = shopItem(kind, id);
      if (this.owns(kind, id) || d.coins < it.price) return false;
      d.coins -= it.price;
      d.owned[kind].push(id);
      d.equipped[kind] = id;      // auto-equip on purchase
      write();
      return true;
    },
    equip(kind, id) {
      if (!this.owns(kind, id)) return false;
      read().equipped[kind] = id; write(); return true;
    },
    /** combined gameplay modifiers from both equipped items */
    mods() {
      const d = read();
      return Object.assign({}, shopItem('ball', d.equipped.ball).mod,
                               shopItem('paddle', d.equipped.paddle).mod);
    },

    reset() { mem = blank(); write(); },
    persistent() {
      try {
        window.localStorage.setItem(KEY + '.t', '1');
        window.localStorage.removeItem(KEY + '.t');
        return true;
      } catch (e) { return false; }
    },
  };
})();

/* ------------------------------------------------------------------
   Star award. v1 tied stars to lives remaining, which meant a perfect
   run and a sloppy-but-lucky run scored identically. This also rewards
   clearing without losing a life at all.
   ------------------------------------------------------------------ */
function starsEarned(livesLeft, livesStart) {
  if (livesLeft >= livesStart) return 3;    // flawless
  if (livesLeft >= 2) return 2;
  return 1;
}

/* Run state — deliberately outside any Scene, as in v1. */
const POWERUPS = [
  { key: 'multi', label: 'MULTI-BALL' },
  { key: 'life',  label: 'EXTRA LIFE' },
  { key: 'laser', label: 'LASER' },
  { key: 'wide',  label: 'WIDE PADDLE' },
  { key: 'slow',  label: 'SLOW TIME' },
];

const RUN = { level: 0, score: 0, lives: 3, coins: 0 };
const LIVES_PER_LEVEL = 3;

</script>
<script>
/* =====================================================================
   BRICK BREAKER - v2

   25 levels across 5 tiers, star-gated progression, a coin shop, and
   backgrounds that are drawn rather than loaded.

   Changes from v1, in short:
     - 5 levels -> 25, grouped into 5 tiers of 5
     - flat ball speed -> per-level curve, plus paddle-width and
       drop-rate curves so difficulty is not one-dimensional
     - stars were decorative -> stars now gate tier entry
     - new coin currency + shop with equippable balls and paddles
     - backgrounds: 371 KB of PNG -> ~12 KB of generator code, rendered
       at device resolution instead of upscaled
     - interface chrome drawn with Graphics, so it stays sharp on any
       display density
     - the four bugs found in the v1 review are fixed; each fix is
       commented at its site with FIX:
   ===================================================================== */

'use strict';

const U = 2;                    // sprite export multiplier
function px(v) { return v * U; }

/* ------------------------------------------------------------------
   Canvas size.

   v1 was a fixed 900x1600 (9:16) with Scale.FIT. Every phone made in the
   last several years is 19.5:9 or 20:9, so FIT letterboxed 17-20% of the
   display - a Pixel 7 lost a fifth of its screen to black bars. Only a
   legacy 16:9 handset fit exactly.

   Fix: lock the WIDTH to 900 logical units so all horizontal layout
   constants keep working, and let the HEIGHT follow the device. Anything
   anchored to the bottom of the screen is positioned from H rather than
   from a hardcoded 1600. Clamped so a very tall or very square display
   still gets a sane play area.
   ------------------------------------------------------------------ */
const LW = 900;
/* Placeholders. measure() sets the real values just before the game is
   constructed - see the note there for why this cannot be done at parse
   time. Everything downstream reads W/H from inside a function, so it sees
   the measured values. */
let LH = 1600, W = px(LW), H = px(LH);

function measure() {
  const w = window.innerWidth || 900;
  const h = window.innerHeight || 1600;
  const ratio = h / w;
  /* [1400, 2400] - aspects 1.56 to 2.67, which covers every phone in use.

     A clamp of [1450, 1680] spans only 1.61-1.87, and no phone falls inside
     it: a Pixel at 2.22 clamped to 1.87 and FIT bar'd the difference top and
     bottom. That is the reported crop. With the full range the canvas matches
     the screen exactly and no bar is drawn at all.

     The 1400 floor stays: below it the gap between the lowest brick row and
     the ball's rest position drops under 340 world px and the level becomes
     unplayable. */
  LH = Math.round(Math.max(1400, Math.min(2400, LW * ratio)));
  W = px(LW);
  H = px(LH);
  measureSafe();
  return LH;
}

/* ------------------------------------------------------------------
   Safe area.

   The Android theme draws this WebView under the notch and the status bar
   (windowLayoutInDisplayCutoutMode=shortEdges + windowFullscreen), and the
   gesture bar sits over the bottom. Measured on real viewports the top bar
   reaches 48-124 LOGICAL units into the canvas - the top HUD row spans
   33-119, so it was partly or wholly hidden on every device.

   The canvas itself stays full-bleed, so the painted backdrop still runs
   to the screen edges. Only the chrome is inset, via tp()/bp() below.

   An inset is in CSS px against the whole screen, so two conversions are
   needed: subtract any letterbox bar (that part of the inset misses the
   canvas entirely), then divide by the FIT scale to reach game px.
   ------------------------------------------------------------------ */
/* A minimum breathing gap even where the OS reports no inset: a fullscreen
   Android WebView with a translucent status bar reports 0 while still
   drawing a bar over the top of the page. */
let SAFE_TOP = px(18), SAFE_BOT = px(14);

function measureSafe() {
  const el = document.getElementById('safe');
  const read = (p) => {
    if (!el) return 0;
    const v = parseFloat(getComputedStyle(el).getPropertyValue(p));
    return isFinite(v) ? v : 0;
  };
  const vw = window.innerWidth || 900, vh = window.innerHeight || 1600;
  const scale = Math.min(vw / W, vh / H) || 1;
  const barY = Math.max(0, (vh - H * scale) / 2);
  const conv = (cssPx) => Math.max(0, (cssPx - barY)) / scale;
  SAFE_TOP = Math.max(conv(read('padding-top')), px(18));
  SAFE_BOT = Math.max(conv(read('padding-bottom')), px(14));
}

/* Distance from the TOP edge, past any cutout. Use for anything anchored
   to the top of the screen. */
function tp(v) { return SAFE_TOP + px(v); }

/* Distance from the bottom edge, in logical units. Use this for anything
   that should sit near the bottom on every device. */
function bp(v) { return H - SAFE_BOT - px(v); }

const COL = {
  text: '#e8eefc', textDim: '#93a3c4', gold: '#ffc63e',
  cream: 0xF7E9C9, creamLo: 0xE9D5A6, creamHi: 0xFFF6E0,
  goldLip: 0xC29A48, brown: 0x4A3520, brownDim: 0x8A7355,
  green: 0x7FBE3F, greenLo: 0x4F8C22, greenLip: 0x3A6A16,
  blue: 0x4a90e2, red: 0xde4a3e, yellow: 0xf5ba30, grey: 0x687894,
};

/* One knob for overall type size. Applied inside the text helpers rather
   than at each call site, so layout constants stay in logical units and
   only the rendered size moves.

   Declared here, ABOVE every consumer: `const` is not hoisted like a
   function is, so a reference from code that appears earlier in the same
   block hits the temporal dead zone and throws at runtime. */
const FONT_SCALE = 1.10;

/* Type. Baloo 2 ExtraBold for display, Luckiest Guy for the big headline,
   Fredoka Bold for buttons, Fredoka Medium for small stats. All five are
   subset to the Latin glyphs the game actually renders - 89 KB rather
   than the 948 KB the full families weigh. */
const FONT = {
  display: 'Baloo2XBold',    // screen titles, level names, score
  headline: 'LuckiestGuy',   // the loudest text on a screen
  button:  'FredokaBold',    // every button label
  small:   'FredokaMedium',  // stats, captions, hints
};
function fpx(v) { return Math.round(px(v) * FONT_SCALE); }

function fitText(scene, x, y, str, size, colour, family, maxW, originX) {
  const t = scene.add.text(x, y, str,
    { fontFamily: family || FONT.display, fontSize: Math.round(size * FONT_SCALE) + 'px', color: colour })
    .setOrigin(originX === undefined ? 0.5 : originX, 0.5);
  let sz = Math.round(size * FONT_SCALE);
  while (t.width > maxW && sz > px(8)) { sz -= 1; t.setFontSize(sz); }
  t.baseSize = Math.round(size * FONT_SCALE); t.maxW = maxW;
  return t;
}
function refit(t, str) {
  if (t.lastStr === str) return;      // FIX: skip the whole measure loop when
  t.lastStr = str;                    // the string has not changed (see Play)
  t.setFontSize(t.baseSize);
  t.setText(str);
  let sz = t.baseSize;
  while (t.width > t.maxW && sz > px(8)) { sz -= 1; t.setFontSize(sz); }
}

/* =====================================================================
   SHARED BACKDROP

   The menu landscape is one painted image (941x1672 - sky, sun rays,
   forested mountains, lake, fence, daisies). Home, Level select and Shop
   all draw it, so the three read as one app rather than three.

   Fitting a fixed painting to an unknown aspect: scale it to the canvas
   WIDTH, pin the landscape half to the bottom, and stretch the sky above
   to cover whatever height is left. Stretching only the sky keeps the
   mountains, lake and grass at their painted proportions - scaling the
   whole thing to cover would crop the fence and flowers off the sides on
   a tall display, and stretching all of it would visibly squash the
   mountains.
   ===================================================================== */
const BG_W = 941, BG_H = 1672;
/* Fraction of the menu painting's height that is still untextured sky.
   Below it the rays converge and the mountains, water and grass begin, so
   nothing under this line may stretch. */
const BG_SKY_FRAC = 620 / 1672;
/* Source row of the lake's far shore - ground level for anything that
   has to stand in the scene. */
const BG_HORIZON = 1130;

/* Fit a fixed painting to the canvas without distorting it: scale to the
   canvas WIDTH, pin the landscape half to the bottom, and stretch the
   plain sky above to cover whatever height is left.

   Shared by the menu backdrop and the per-level paintings, which are all
   the same composition - sky on top, scenery on the bottom - so one
   fitter serves both. */
/* Split a painting into a 'sky' frame and a 'land' frame, once per texture.
   Frames cost nothing - they are just rectangles into the existing image. */
function paintingFrames(scene, srcKey, skyFrac) {
  const tex = scene.textures.get(srcKey);
  const src = tex.getSourceImage();
  const sw = src.width, sh = src.height;
  const skyRow = Math.max(1, Math.min(sh - 1, Math.round(sh * skyFrac)));
  if (!tex.has('sky')) {
    tex.add('sky', 0, 0, 0, sw, skyRow);
    tex.add('land', 0, 0, skyRow, sw, sh - skyRow);
  }
  const landH = Math.min(H, Math.round((sh - skyRow) * (W / sw)));
  return { skyRow: skyRow, landH: landH, landY: H - landH, sw: sw, sh: sh };
}

/* Lay a painting over the canvas as TWO sprites.

   This used to composite into a full W x H canvas per level: 1800x3998, ~29 MB
   of pixels each, ~370 MB across the 13 level paintings, plus a 67 ms bake on
   every level change - and under WebGL a GPU upload of all of it. Two frames
   off the source texture render exactly the same picture: the landscape at
   natural width-scale pinned to the bottom, the plain sky above it stretched
   over the remaining height. */
function paintingBands(scene, srcKey, skyFrac) {
  const m = paintingFrames(scene, srcKey, skyFrac);
  const out = [];
  if (m.landY > 0) {
    out.push(scene.add.image(0, 0, srcKey, 'sky').setOrigin(0, 0)
      .setDisplaySize(W, m.landY));
  }
  out.push(scene.add.image(0, m.landY, srcKey, 'land').setOrigin(0, 0)
    .setDisplaySize(W, m.landH));
  return out;
}

/* Returns the y of the lake's far shore, for anything that wants to sit
   on the ground. The old horizon/horizonPx options described a procedural
   scene that no longer exists - the painting sets its own horizon. */
function paintBackdrop(scene) {
  paintingBands(scene, 'nbBg', BG_SKY_FRAC);
  const m = paintingFrames(scene, 'nbBg', BG_SKY_FRAC);
  return m.landY + (BG_HORIZON - m.skyRow) * (m.landH / (m.sh - m.skyRow));
}

/* Recombine a sprite stored as JPEG colour + PNG alpha into one texture.
   PNG spent 410 KB on the logo because its smooth gradients defeat the
   row filters; JPEG colour plus an 8-bit mask is 87 KB, and sharper than
   quantising the PNG to 256 colours. */
function recombineSplit(scene, key) {
  const out = key + 'X';
  if (scene.textures.exists(out)) return out;
  const rgb = scene.textures.get(key).getSourceImage();
  const a = scene.textures.get(key + 'A').getSourceImage();
  const w = rgb.width, h = rgb.height;

  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const g = c.getContext('2d');
  g.drawImage(rgb, 0, 0);
  const img = g.getImageData(0, 0, w, h);

  const ac = document.createElement('canvas');
  ac.width = w; ac.height = h;
  const ag = ac.getContext('2d');
  ag.drawImage(a, 0, 0);
  const am = ag.getImageData(0, 0, w, h).data;

  const d = img.data;
  for (let i = 0, n = w * h; i < n; i++) d[i * 4 + 3] = am[i * 4];
  g.putImageData(img, 0, 0);
  scene.textures.addCanvas(out, c);
  return out;
}

/* =====================================================================
   CHROME — GUI Pro Casual Game 2.0 assets, nine-sliced.

   Phaser's own NineSlice game object draws nothing under the CANVAS
   renderer, and this build forces CANVAS for old-WebView compatibility.
   So the slicing is done here instead: the source PNG is composited into
   an offscreen canvas at the size we need and registered as a texture.
   Corners stay pixel-exact, edges and centre stretch. Cached by
   key+size, so a button drawn 25 times costs one bake.
   ===================================================================== */

const _sliceCache = {};

/**
 * @param {Phaser.Scene} scene
 * @param {string} key    source texture key
 * @param {number} w      target width in world px
 * @param {number} h      target height in world px
 * @param {number} inset  corner size in SOURCE px (uniform)
 * @returns {string} texture key of the baked result
 */
function slice(scene, key, w, h, inset) {
  w = Math.max(1, Math.round(w));
  h = Math.max(1, Math.round(h));
  const ck = 'ns_' + key + '_' + w + 'x' + h;
  if (_sliceCache[ck]) return ck;
  if (scene.textures.exists(ck)) { _sliceCache[ck] = 1; return ck; }

  const src = scene.textures.get(key).getSourceImage();
  const sw = src.width, sh = src.height;
  // an inset larger than half the source would make the corners overlap
  const i = Math.max(1, Math.min(inset, Math.floor(Math.min(sw, sh) / 2) - 1));

  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const g = c.getContext('2d');

  const cw = Math.min(i, Math.floor(w / 2));   // corner size in the TARGET
  const chh = Math.min(i, Math.floor(h / 2));
  const mw = Math.max(0, w - cw * 2);          // stretched middle
  const mh = Math.max(0, h - chh * 2);
  const smw = Math.max(1, sw - i * 2);
  const smh = Math.max(1, sh - i * 2);

  // corners
  g.drawImage(src, 0, 0, i, i, 0, 0, cw, chh);
  g.drawImage(src, sw - i, 0, i, i, w - cw, 0, cw, chh);
  g.drawImage(src, 0, sh - i, i, i, 0, h - chh, cw, chh);
  g.drawImage(src, sw - i, sh - i, i, i, w - cw, h - chh, cw, chh);
  // edges
  if (mw > 0) {
    g.drawImage(src, i, 0, smw, i, cw, 0, mw, chh);
    g.drawImage(src, i, sh - i, smw, i, cw, h - chh, mw, chh);
  }
  if (mh > 0) {
    g.drawImage(src, 0, i, i, smh, 0, chh, cw, mh);
    g.drawImage(src, sw - i, i, i, smh, w - cw, chh, cw, mh);
  }
  // centre
  if (mw > 0 && mh > 0) g.drawImage(src, i, i, smw, smh, cw, chh, mw, mh);

  scene.textures.addCanvas(ck, c);
  _sliceCache[ck] = 1;
  return ck;
}

/* Panels -------------------------------------------------------------
   Cream with a gold border, from the Level Complete sheet. Every box in
   the game comes from these two, so the popups, the level rows and the
   shop cards all read as one design.

   Both sources are compacted: the sheet's panel is 666x651 and its inner
   box carries three baked divider lines, so each was rebuilt from just
   its four corners. That drops the redundant middle - and the dividers
   with it - leaving a source whose whole area is corner and edge, which
   is all a 9-slice ever samples. Hence the large insets. */
function panel(scene, x, y, w, h) {
  return scene.add.image(x, y, slice(scene, 'lvPanel', w, h, 130)).setOrigin(0, 0);
}
function card(scene, x, y, w, h) {
  return scene.add.image(x, y, slice(scene, 'lvBox', w, h, 60)).setOrigin(0, 0);
}

/* The blue banner every popup wears across its top edge. The sheet's
   ribbon had "LEVEL COMPLETE" painted into it, so it was blanked when the
   asset was cut and the title is drawn live - which is what lets PAUSED,
   OUT OF LIVES and SETTINGS share one banner. */
function popupRibbon(scene, cx, topY, title, w) {
  const rw = w || px(468), rh = rw * (95 / 529);
  const img = scene.add.image(cx, topY, 'lvRibbon').setDisplaySize(rw, rh).setDepth(53);
  const t = fitText(scene, cx, topY - rh * 0.10, title, px(30), '#FFF4D8',
    FONT.button, rw * 0.76).setDepth(54);
  t.setStroke('#123A6B', Math.max(2, Math.round(px(30) * 0.10)));
  return [img, t];
}

/* Buttons ------------------------------------------------------------
   The glossy gold/blue/green keys from the same sheet. `cream` maps to
   gold because that is what the reference uses for secondary actions;
   `grey` is derived from the blue one at load, for a disabled NEXT. */
const BTN_TEX = { green: 'lvBtnGreen', cream: 'lvBtnGold', blue: 'lvBtnBlue',
                  grey: 'lvBtnGreyX', red: 'lcBtnRed' };
const BTN_INSET = 44;

/* Desaturate a texture into a new one - used for the disabled button, so
   it matches the new art instead of falling back to the old flat grey. */
function bakeGrey(scene, key, out) {
  if (scene.textures.exists(out)) return out;
  const src = scene.textures.get(key).getSourceImage();
  const w = src.width, h = src.height;
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const g = c.getContext('2d');
  g.drawImage(src, 0, 0);
  const im = g.getImageData(0, 0, w, h), d = im.data;
  for (let i = 0; i < d.length; i += 4) {
    const v = d[i] * 0.30 + d[i + 1] * 0.59 + d[i + 2] * 0.11;
    d[i] = d[i + 1] = d[i + 2] = Math.min(255, v * 0.82 + 34);
  }
  g.putImageData(im, 0, 0);
  scene.textures.addCanvas(out, c);
  return out;
}

function pill(scene, cx, cy, w, h, label, size, kind, onClick, iconKey) {
  const tex = BTN_TEX[kind] || BTN_TEX.cream;
  const img = scene.add.image(cx, cy, slice(scene, tex, w, h, BTN_INSET));
  /* Every button in the source art carries a white label with a dark
     outline, including the yellow one - so white reads correctly on all
     of them and the old brown-on-cream case no longer applies. */
  const t = fitText(scene, cx + (iconKey ? px(22) : 0), cy - h * 0.08, label, size,
    '#ffffff', FONT.button, w * 0.68);
  let ico = null;
  if (iconKey) {
    ico = scene.add.image(t.x - t.width / 2 - px(32), cy - h * 0.07, iconKey)
      .setDisplaySize(h * 0.46, h * 0.46);
  }
  t.setShadow(0, px(3), 'rgba(0,0,0,0.42)', 0, false, true);

  /* Zone rather than Container: a Container hit area answers mouse but
     never fires pointerdown from touch, which leaves buttons dead on the
     actual target device. */
  const z = scene.add.zone(cx, cy, w, h).setInteractive({ useHandCursor: true });
  const movers = ico ? [img, t, ico] : [img, t];
  /* Press reads as the button physically sinking: it drops onto its own
     bevel and narrows very slightly, rather than just nudging down. */
  z.on('pointerdown', () => {
    scene.tweens.add({ targets: movers, y: '+=' + px(6), duration: 70, yoyo: true, ease: 'Quad.easeOut' });
    scene.tweens.add({ targets: [img], scaleX: img.scaleX * 0.975, scaleY: img.scaleY * 0.94,
      duration: 70, yoyo: true, ease: 'Quad.easeOut' });
    if (onClick) onClick();
  });
  z.once('destroy', () => { img.destroy(); t.destroy(); if (ico) ico.destroy(); });
  const sd = z.setDepth.bind(z);
  z.setDepth = function (d) { sd(d); img.setDepth(d); t.setDepth(d + 1); if (ico) ico.setDepth(d + 1); return z; };
  return { img: z, txt: t, g: img };
}





/* Coin balance and stat capsule, shared by every menu screen so the three
   read as one app. Both are the redesign's own dark capsules, 9-sliced so
   they stretch to any width, with the numbers drawn live - the supplied
   art has "0" and "0 / 75 STARS" baked into the pixels. */
const CAP_INSET = 34;

function coinBar(scene, rightX, cy) {
  const w = px(212), h = Math.round(w * (96 / 233)), x = rightX - w;
  const items = [];
  items.push(scene.add.image(x, cy, slice(scene, 'nbCapS', w, h, CAP_INSET))
    .setOrigin(0, 0.5));
  items.push(scene.add.image(x + px(40), cy, 'nbCoin').setDisplaySize(px(50), px(56)));
  items.push(scene.add.text(x + px(70), cy, String(SAVE.coins()),
    { fontFamily: FONT.button, fontSize: fpx(26) + 'px', color: '#FFFFFF' })
    .setOrigin(0, 0.5).setShadow(0, px(2), 'rgba(0,0,0,0.5)', 0, false, true));
  /* The plus sits proud of the capsule's right end, as in the reference. */
  items.push(scene.add.image(x + w - px(30), cy, 'nbPlus').setDisplaySize(px(58), px(62)));
  return { destroy() { items.forEach((o) => o.destroy()); } };
}

function statCapsule(scene, cx, cy) {
  const w = px(654), h = Math.round(w * (106 / 710));
  scene.add.image(cx, cy, slice(scene, 'nbCapL', w, h, CAP_INSET)).setOrigin(0.5);
  const half = w / 2;
  scene.add.image(cx - half + px(56), cy, 'rdStar').setDisplaySize(px(54), px(52));
  scene.add.text(cx - half + px(92), cy,
    SAVE.totalStars() + ' / ' + MAX_STARS + ' STARS',
    { fontFamily: FONT.button, fontSize: fpx(24) + 'px', color: '#FFD86B' })
    .setOrigin(0, 0.5);
  const div = scene.add.graphics();
  div.fillStyle(0xFFFFFF, 0.18);
  div.fillRect(cx - px(6), cy - px(26), px(3), px(52));
  scene.add.image(cx + px(56), cy, 'rdCrown').setDisplaySize(px(54), px(48));
  scene.add.text(cx + px(92), cy,
    'BEST ' + SAVE.bestScore().toLocaleString('en-US'),
    { fontFamily: FONT.button, fontSize: fpx(24) + 'px', color: '#FFD86B' })
    .setOrigin(0, 0.5);
}

/* =====================================================================
   SHOP SHOWCASE

   The disc an item sits on: a pale radial burst inside a blue ring. Baked
   to a texture because the burst wants per-pixel wedges and a radial
   gradient, neither of which Phaser's Graphics can draw under the CANVAS
   renderer this build forces.
   ===================================================================== */
function bakeShowcase(scene, size) {
  size = Math.round(size);
  const key = 'shopWell_' + size;
  if (scene.textures.exists(key)) return key;
  const c = document.createElement('canvas');
  c.width = size; c.height = size;
  const g = c.getContext('2d');
  const r = size / 2, cx = r, cy = r, ringW = Math.max(2, size * 0.042);

  const face = g.createRadialGradient(cx, cy, 0, cx, cy, r);
  face.addColorStop(0, '#FFFFFF');
  face.addColorStop(0.60, '#EAF6FD');
  face.addColorStop(1, '#CBE4F5');
  g.beginPath(); g.arc(cx, cy, r - ringW * 0.5, 0, Math.PI * 2);
  g.fillStyle = face; g.fill();

  /* Wedges, then a white radial wash over them: without the wash they
     read as a pie chart rather than as light coming off the item. */
  g.save();
  g.beginPath(); g.arc(cx, cy, r - ringW, 0, Math.PI * 2); g.clip();
  const n = 26, span = (Math.PI * 2) / n;
  g.fillStyle = 'rgba(142,190,224,0.34)';
  for (let i = 0; i < n; i += 2) {
    g.beginPath(); g.moveTo(cx, cy);
    g.arc(cx, cy, r, i * span, (i + 1) * span);
    g.closePath(); g.fill();
  }
  const wash = g.createRadialGradient(cx, cy, 0, cx, cy, r);
  wash.addColorStop(0, 'rgba(255,255,255,0.96)');
  wash.addColorStop(0.52, 'rgba(255,255,255,0.30)');
  wash.addColorStop(1, 'rgba(255,255,255,0)');
  g.fillStyle = wash; g.fillRect(0, 0, size, size);
  g.restore();

  g.beginPath(); g.arc(cx, cy, r - ringW / 2, 0, Math.PI * 2);
  g.lineWidth = ringW; g.strokeStyle = '#3E9BD8'; g.stroke();
  g.beginPath(); g.arc(cx, cy, r - ringW * 1.45, 0, Math.PI * 2);
  g.lineWidth = Math.max(1, ringW * 0.28);
  g.strokeStyle = 'rgba(255,255,255,0.7)'; g.stroke();

  scene.textures.addCanvas(key, c);
  return key;
}

/* Four-point sparkle - the accent the reference scatters round the disc. */
function sparkle(scene, x, y, s, alpha) {
  const g = scene.add.graphics().setAlpha(alpha === undefined ? 0.9 : alpha);
  const n = s * 0.26;
  g.fillStyle(0xFFF0BE, 1);
  g.beginPath();
  g.moveTo(x, y - s);     g.lineTo(x + n, y - n);
  g.lineTo(x + s, y);     g.lineTo(x + n, y + n);
  g.lineTo(x, y + s);     g.lineTo(x - n, y + n);
  g.lineTo(x - s, y);     g.lineTo(x - n, y - n);
  g.closePath(); g.fillPath();
  return g;
}

/* Back button: a dark rounded box from the pill 9-slice plus a LIGHT
   arrow. rdGear cannot serve as the box - it has a gear baked into it -
   and the default icBack is brown, which disappears on dark. */
function backButton(scene, cx, cy, onClick) {
  const s = px(96);
  /* The blue key from the button sheet, not the dark pill - on the bright
     daylight backdrop the dark one read as a hole in the layout. */
  const box = scene.add.image(cx, cy, slice(scene, 'lvBtnBlue', s, s, 44));
  const ic = scene.add.image(cx, cy, 'icBackLight').setDisplaySize(px(42), px(42));
  const z = scene.add.zone(cx, cy, px(112), px(112)).setInteractive({ useHandCursor: true });
  z.on('pointerdown', () => {
    scene.tweens.add({ targets: [box, ic], y: cy + px(4), duration: 60, yoyo: true });
    onClick();
  });
  return z;
}



/* Chrome (panel, card, pill, iconButton, currencyBar, slice) is defined
   in the chrome block above, backed by the GUI Pro asset pack. */

/* Fraction of a level painting that is plain sky and may be stretched. */
const LVBG_SKY_FRAC = 0.40;

/* Which painting each level uses. 1-based indices into lvbg1..lvbg13.

   Every level is matched to its BIOME - the same table the procedural
   generator keyed off - so a desert level gets the cactus painting, a
   night level a moonlit one, a volcanic level an ember or ash one.
   Ordered so no two consecutive levels repeat a painting, which is what
   would make the reuse obvious.

   Paintings 9-13 are NOT in the order they arrived. Taken literally,
   level 11 DUNE MARCH (desert) drew the lantern-lit night painting while
   levels 16 and 21 - also desert - drew the cactus one, which reads as a
   mistake inside one game. Shifting those five by one makes each agree
   with both its level name and its biome: GLYPHS OF MOSS gets the carved
   stone, TANGLEROOT the tangled roots, DUNE MARCH the dunes, NIGHTFALL
   PATH the lanterns, THE ASH GATE the ash field.

   Snow (level 17) has no painting of its own; silver-thicket is the
   nearest thing, reading as frosted rather than green. */
const LVBG = [
  /*  1-13 */ 1, 2, 3, 4, 5, 6, 7, 8, 13, 9, 10, 11, 12,
  /* 14-25 */ 1, 5, 10, 7, 8, 4, 9, 10, 2, 12, 13, 7,
];

/* Paint the page behind the canvas with the backdrop's own vertical colour
   profile.

   FIT never crops or stretches, which is what keeps the HUD safe, but it does
   leave a bar wherever the device aspect still falls outside the clamp - a 4:3
   tablet, a desktop window, a foldable. That bar was flat #101f30, which
   against a bright daylight painting read as a black edge around the game.

   Sampling a column out of the backdrop and replaying it as a CSS gradient
   makes the bar continue the sky at the top and the grass at the bottom, so it
   passes for part of the scene. One 1xN downscale, run once at boot. */
function paintPageBackdrop(scene) {
  const wrap = document.getElementById('wrap');
  if (!wrap || !scene.textures.exists('nbBg')) return;
  const src = scene.textures.get('nbBg').getSourceImage();
  const N = 12;
  const c = document.createElement('canvas');
  c.width = 1; c.height = N;
  const g = c.getContext('2d');
  g.drawImage(src, 0, 0, src.width, src.height, 0, 0, 1, N);
  const d = g.getImageData(0, 0, 1, N).data;
  const stops = [];
  for (let i = 0; i < N; i++) {
    const o = i * 4;
    stops.push('rgb(' + d[o] + ',' + d[o + 1] + ',' + d[o + 2] + ') ' +
               Math.round((i / (N - 1)) * 100) + '%');
  }
  wrap.style.background = 'linear-gradient(to bottom,' + stops.join(',') + ')';
}

/* The backdrop for a level.

   Levels that ship a painting (lvbg1, lvbg2, ...) use it, fitted the same
   way as the menu so it is never squashed. The rest fall back to the
   procedural generator, which still covers every level beyond the
   supplied set. */
function bgTexture(scene, level, w, h) {
  /* Painted levels are drawn by paintingBands(); only the procedural
     fallback still needs a baked texture. */
  const art = 'lvbg' + (LVBG[level] || 0);
  if (scene.textures.exists(art)) return null;
  const key = 'pbg_' + level + '_' + w;
  if (scene.textures.exists(key)) return key;
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  renderBackground(c, level);
  scene.textures.addCanvas(key, c);
  return key;
}

/* ====================================================================
   BOOT
   ==================================================================== */
class Boot extends Phaser.Scene {
  constructor() { super('Boot'); }

  preload() {
    Object.keys(SPRITES).forEach((k) => this.load.image(k, SPRITES[k]));
    const g = this.add.graphics();
    this.load.on('progress', (p) => {
      g.clear();
      g.fillStyle(0x1b2440, 1); g.fillRoundedRect(W / 2 - px(180), H / 2, px(360), px(16), px(8));
      g.fillStyle(0x4a90e2, 1); g.fillRoundedRect(W / 2 - px(180), H / 2, px(360) * p, px(16), px(8));
    });
  }

  create() {
    /* The logo ships as JPEG colour + PNG alpha; stitch it back together
       once, here, so every scene can just use the combined key. */
    recombineSplit(this, 'nbLogo');
    bakeGrey(this, 'lvBtnBlue', 'lvBtnGreyX');
    paintPageBackdrop(this);

    /* document.fonts.ready resolves before a face that nothing has asked
       for yet is actually loaded, so the first text drawn would fall back
       to a system font and then visibly reflow. Forcing a load of each
       family first is what makes the wait meaningful - and it has to name
       the families actually in use, or the wait is measuring nothing. */
    const wait = (document.fonts && document.fonts.load)
      ? Promise.all([
          document.fonts.load('800 40px ' + FONT.display),
          document.fonts.load('400 40px ' + FONT.headline),
          document.fonts.load('700 40px ' + FONT.button),
          document.fonts.load('500 40px ' + FONT.small),
        ]).catch(() => null)
      : Promise.resolve();
    wait.then(() => this.scene.start('Home'));
  }
}

/* ====================================================================
   HOME
   ==================================================================== */
class Home extends Phaser.Scene {
  constructor() { super('Home'); }

  create() {
    paintBackdrop(this);

    /* Button stack, bottom-anchored, at the reference's own offsets in a
       900x1580 layout. Each button keeps its artwork's aspect - the three
       supplied PNGs are not the same proportion as each other, so forcing
       a common height would stretch two of the three. */
    const playW = px(470), playH = playW * (199 / 528);
    const playCy = bp(548);
    const playTop = playCy - playH / 2;

    /* ---- top bar ---- */
    const gear = this.add.image(px(70), tp(72), 'nbGear').setDisplaySize(px(86), px(94));
    const gz = this.add.zone(px(70), tp(72), px(120), px(120)).setInteractive({ useHandCursor: true });
    gz.on('pointerdown', () => {
      this.tweens.add({ targets: gear, y: gear.y + px(4), duration: 60, yoyo: true });
      this.showSettings();
    });
    coinBar(this, W - px(22), tp(72));

    /* Mascot geometry first - the logo is positioned against its head, so
       the metrics have to exist before the logo is placed. */
    const mH = px(288), mW = mH * (287 / 290);
    const feet = playTop + px(74);       // legs disappear behind the button
    const mascotTop = feet - mH;

    /* ---- logo ----
       Centred 36% of the way down the band between the top bar and the
       mascot's head, rather than pinned to a fixed fraction of H. Pinning
       it high dumped all of a tall display's extra height into one dead gap
       between logo and mascot; sharing the slack holds the reference's
       spacing, whose own aspect puts the logo at 0.21 H. */
    const barBottom = tp(130);
    const band = mascotTop - barBottom;
    let logoW = px(586), logoH = logoW * (473 / 632);
    /* Shrink to fit the band when there is not room for the logo at full
       size. LH floors at 1400 for tablets, landscape and any short browser
       window, and at that height the logo's natural 438 logical units
       overran the band and its lower half sat on the mascot's head. Tall
       phones are unaffected - the band is roughly twice what is needed, so
       this scales nothing and the placement below is unchanged. */
    const logoMaxH = band * 0.74;
    if (logoH > logoMaxH) {
      const k = logoMaxH / logoH;
      logoW *= k; logoH *= k;
    }
    const logoCy = Math.max(barBottom + logoH / 2, barBottom + band * 0.36);
    this.add.image(W / 2, logoCy, 'nbLogoX').setDisplaySize(logoW, logoH);

    /* ---- mascot, standing in the meadow behind the PLAY button.
       The painting carries its own ground, so there is no plateau or
       scatter to add - just a contact shadow to seat it. ---- */
    this.add.image(W / 2, feet - px(10), 'rdMascotShadow')
      .setDisplaySize(px(200), px(42)).setAlpha(0.26);
    this.add.image(W / 2, feet - mH / 2, 'rdMascot').setDisplaySize(mW, mH);

    /* ---- buttons ----
       The supplied art is unlabelled, and the sheet's own PLAY/LEVELS/SHOP
       lettering is inconsistent (PLAY has a dark outline, the other two
       have none). So the labels are drawn live in the game's own button
       face with a matching outline: consistent across all three, sharp at
       any size, and translatable. */
    this.artButton(W / 2, playCy, playW, 'nbPlay', 'PLAY', px(64), '#7A4310',
      () => this.scene.start('Play', { level: SAVE.nextLevel() }));
    this.artButton(W / 2, bp(374), px(452), 'nbLevels', 'LEVELS', px(46), '#12467F',
      () => this.scene.start('LevelSelect'));
    this.artButton(W / 2, bp(228), px(452), 'nbShop', 'SHOP', px(46), '#2A6410',
      () => this.scene.start('Shop'));

    statCapsule(this, W / 2, bp(100));

    if (!SAVE.persistent()) {
      fitText(this, W / 2, bp(36), 'PROGRESS WILL NOT BE SAVED IN THIS BROWSER MODE',
        px(14), '#FFFFFF', FONT.small, px(760));
    }
  }

  /* One menu button: artwork at its own aspect, a live label, and a hit
     zone. Width only - the height comes from the texture, so the art
     cannot be stretched. */
  artButton(cx, cy, w, key, label, size, ink, onClick) {
    const src = this.textures.get(key).getSourceImage();
    const h = w * (src.height / src.width);
    const img = this.add.image(cx, cy, key).setDisplaySize(w, h);
    /* The art carries a drop shadow below the button face, so the label
       centres slightly above the image's own middle. */
    const t = fitText(this, cx, cy - h * 0.06, label, size, '#FFFFFF',
      FONT.button, w * 0.74);
    /* Outline at ~9% of the type size. It was 22%, which at this size is a
       28px stroke - the letters filled in and read as brown blobs. */
    t.setStroke(ink, Math.max(2, Math.round(size * 0.09)));
    t.setShadow(0, px(3), 'rgba(0,0,0,0.28)', 0, false, true);

    const z = this.add.zone(cx, cy, w, h).setInteractive({ useHandCursor: true });
    z.on('pointerdown', () => {
      this.tweens.add({ targets: [img, t], y: '+=' + px(6), duration: 70,
        yoyo: true, ease: 'Quad.easeOut' });
      this.tweens.add({ targets: [img], scaleX: img.scaleX * 0.975,
        scaleY: img.scaleY * 0.94, duration: 70, yoyo: true, ease: 'Quad.easeOut' });
      if (onClick) onClick();
    });
    z.once('destroy', () => { img.destroy(); t.destroy(); });
    return { img: z, txt: t, g: img };
  }

  showSettings() {
    if (this.dimRect) return;
    this.dimRect = this.add.rectangle(W / 2, H / 2, W, H, 0x070a12, 0.7).setDepth(50);
    const items = [this.dimRect];
    items.push(panel(this, W / 2 - px(300), px(560), px(600), px(420)).setDepth(51));
    popupRibbon(this, W / 2, px(560), 'SETTINGS', px(468)).forEach((o) => items.push(o));
    items.push(fitText(this, W / 2, px(686), 'Resetting erases all stars, coins and progress.',
      px(20), '#8A7355', FONT.small, px(500)).setDepth(52));

    const reset = pill(this, W / 2, px(800), px(440), px(84), 'RESET PROGRESS', px(26), 'cream', () => {
      SAVE.reset();
      items.forEach((o) => o.destroy());
      this.dimRect = null;
      this.scene.restart();
    });
    const close = pill(this, W / 2, px(900), px(440), px(84), 'CLOSE', px(26), 'green', () => {
      items.forEach((o) => o.destroy());
      this.dimRect = null;
    });
    [reset, close].forEach((r) => { r.img.setDepth(52); r.txt.setDepth(53); items.push(r.img, r.txt); });
  }
}

/* ====================================================================
   LEVEL SELECT - 25 cards, drag-scrolled
   ==================================================================== */
class LevelSelect extends Phaser.Scene {
  constructor() { super('LevelSelect'); }

  create() {
    // same scene as Home, so the two screens read as one app
    paintBackdrop(this);
    this.add.rectangle(W / 2, H / 2, W, H, 0x081A26, 0.30);

    backButton(this, px(74), tp(84), () => this.scene.start('Home')).setDepth(60);
    coinBar(this, W - px(38), tp(84));

    fitText(this, W / 2, tp(178), 'SELECT LEVEL', px(52), '#FFF8E6', FONT.display, px(640))
      .setShadow(0, px(3), 'rgba(0,0,0,0.4)', 0, false, true);

    const st = SAVE.totalStars();
    this.add.image(W / 2 - px(50), tp(238), 'rdStar').setDisplaySize(px(40), px(38));
    fitText(this, W / 2 + px(16), tp(238), st + ' / ' + MAX_STARS, px(26), COL.gold, FONT.button, px(220));

    /* ---- scroll viewport ---- */
    /* Viewport starts below the star row, floored at the original 290 so
       a device reporting no inset is unchanged. Fixed at 290 it ran up
       under the header once the inset pushed the stars down. */
    const VT = Math.max(px(290), tp(276)), VB = bp(270);
    this.viewTop = VT; this.viewH = VB - VT;

    this.list = this.add.container(0, 0);
    const maskG = this.make.graphics({ x: 0, y: 0, add: false });
    maskG.fillRect(0, VT, W, this.viewH);
    this.list.setMask(maskG.createGeometryMask());

    this.cardTops = [];
    let y = VT + px(14);
    for (let i = 0; i < LEVEL_COUNT; i++) {
      if (i % 5 === 0) { this.buildTierHeader(i, y); y += px(66); }
      this.buildCard(i, y);
      this.cardTops.push(y);
      y += px(138);
    }
    this.contentH = y - VT + px(20);
    this.scrollMin = Math.min(0, this.viewH - this.contentH);
    this.scrollY = 0;

    this.setupScroll();

    /* ---- footer ---- */
    panel(this, px(60), bp(248), W - px(120), px(196));
    this.add.image(px(130), bp(190), 'starOn').setDisplaySize(px(44), px(44));
    fitText(this, px(174), bp(200), 'BEST SCORE', px(19), '#8A7355', FONT.small, px(220), 0);
    fitText(this, px(174), bp(170), SAVE.bestScore().toLocaleString('en-US'), px(28), '#4A3520', FONT.display, px(240), 0);
    fitText(this, W - px(130), bp(200), st + ' / ' + MAX_STARS, px(28), '#4A3520', FONT.display, px(220), 1);
    fitText(this, W - px(130), bp(168), 'STARS EARNED', px(19), '#8A7355', FONT.small, px(220), 1);

    const nx = SAVE.nextLevel();
    pill(this, W / 2, bp(98), W - px(200), px(84), 'PLAY LEVEL ' + (nx + 1), px(28), 'green',
      () => this.scene.start('Play', { level: nx }));

    /* Open on the level the player is actually up to, rather than at the
       top - by level 20 that would otherwise be four screens of scrolling
       every single time they come back here. */
    if (nx > 1) {
      const target = -(this.cardTops[nx] - VT - px(200));
      this.scrollTo(Phaser.Math.Clamp(target, this.scrollMin, 0));
    }
  }

  buildTierHeader(i, y) {
    const t = TIERS[i / 5];
    const gate = t.starGate;
    const met = SAVE.totalStars() >= gate;
    const label = t.name + '  ·  SPEED ' + speedFor(i) + '-' + speedFor(i + 4) +
      (gate > 0 ? ('  ·  ' + gate + '\u2605') : '');
    const txt = fitText(this, W / 2, y + px(28), label, px(21),
      met ? '#EAF3D8' : '#B9A98C', FONT.display, px(700));
    txt.setShadow(0, px(2), 'rgba(0,0,0,0.5)', 0, false, true);
    const g = this.add.graphics();
    g.lineStyle(px(2), 0xFFFFFF, met ? 0.22 : 0.10);
    g.lineBetween(px(70), y + px(28), W / 2 - txt.width / 2 - px(20), y + px(28));
    g.lineBetween(W / 2 + txt.width / 2 + px(20), y + px(28), W - px(70), y + px(28));
    this.list.add([g, txt]);
  }

  buildCard(i, y) {
    const unlocked = SAVE.isUnlocked(i);
    const got = SAVE.starsFor(i);
    const t = TIERS[tierOf(i)];
    const x = px(60), w = W - px(120), h = px(124);

    /* The row is the shared cream panel, not hand-drawn any more - it was
       still the old palette while every other box in the game had moved
       to the new art.

       panel() rather than card(): card()'s box is 74% opaque, which reads
       fine inside a popup but over the painted level backdrop it let the
       scenery through and the rows lost their edges. */
    const box = panel(this, x, y, w, h);
    if (!unlocked) box.setAlpha(0.78);
    const kids = [box];

    /* Thumbnail cropped from the level's ACTUAL painting, so the card and
       the level agree. It used to run renderBackground(), the procedural
       generator, which stopped matching once the paintings went in.

       The crop is a landscape band across the horizon - mountains, water
       and near grass - and its left edge is faded to transparent inside
       the canvas, so it dissolves into the card whatever colour the card
       is. Falls back to the generator for any level with no painting. */
    const tk = 'thumb_' + i;
    if (!this.textures.exists(tk)) {
      const TW = 300, TH = 207;             // 1.45, matching the display box
      const c = document.createElement('canvas');
      c.width = TW; c.height = TH;
      const cg = c.getContext('2d');
      const art = 'lvbg' + (LVBG[i] || 0);
      if (this.textures.exists(art)) {
        const src = this.textures.get(art).getSourceImage();
        const bandH = Math.round(src.width * (TH / TW));
        cg.drawImage(src, 0, Math.round(src.height * 0.46), src.width, bandH,
          0, 0, TW, TH);
      } else {
        renderBackground(c, i);
      }
      cg.globalCompositeOperation = 'destination-out';
      const grad = cg.createLinearGradient(0, 0, TW * 0.34, 0);
      grad.addColorStop(0, 'rgba(0,0,0,1)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      cg.fillStyle = grad;
      cg.fillRect(0, 0, TW * 0.34, TH);
      this.textures.addCanvas(tk, c);
    }
    const th = this.add.image(x + w - px(96), y + h / 2, tk).setDisplaySize(px(180), px(124));
    if (!unlocked) th.setAlpha(0.40);   // alpha works on CANVAS; tint does not
    kids.push(th);

    // badge
    const bx = x + px(48), by = y + h / 2, br = px(36);
    const bg = this.add.graphics();
    bg.fillStyle(0x000000, 0.22); bg.fillCircle(bx, by + px(4), br);
    bg.fillStyle(unlocked ? t.colour : 0x7A5B3E, 1); bg.fillCircle(bx, by, br);
    bg.fillStyle(0xFFFFFF, 0.30); bg.fillEllipse(bx, by - br * 0.42, br * 1.3, br * 0.62);
    kids.push(bg);
    if (unlocked) {
      kids.push(this.add.text(bx, by, String(i + 1),
        { fontFamily: FONT.display, fontSize: fpx(30) + 'px', color: '#ffffff' }).setOrigin(0.5));
    } else {
      kids.push(this.add.image(bx, by, 'icLockLight').setDisplaySize(px(34), px(34)));
    }

    // name
    kids.push(fitText(this, x + px(96), y + px(38), LEVELS[i].name, px(26),
      unlocked ? '#3A2A16' : '#8A7355', FONT.display, px(330), 0));

    /* The second line is EITHER progress or a requirement, never both.
       Drawing stars at y+76 and the unlock text at y+78 put them on top
       of each other, so every locked card rendered its stars with
       "...PREVIOUS LEVEL" struck through them. */
    if (unlocked) {
      for (let s = 0; s < 3; s++) {
        kids.push(this.add.image(x + px(112) + s * px(42), y + px(80),
          s < got ? 'starOn' : 'starOff').setDisplaySize(px(34), px(34)));
      }

      /* Speed pips: taller, wider and darker than before. At 8x22 in
         #CBB78F on a cream card the unlit pips were invisible and the lit
         ones read as noise, which made the difficulty ramp - the thing
         they exist to communicate - impossible to see at a glance. */
      const pips = Math.min(5, 1 + Math.floor(i / 5));
      const pg = this.add.graphics();
      const px0 = x + px(252);
      pg.fillStyle(0x000000, 0.10);
      pg.fillRoundedRect(px0 - px(8), y + px(62), px(5 * 18 + 12), px(36), px(10));
      for (let p = 0; p < 5; p++) {
        pg.fillStyle(p < pips ? 0xD9541F : 0xB8A588, 1);
        pg.fillRoundedRect(px0 + p * px(18), y + px(68), px(11), px(24), px(5));
      }
      kids.push(pg);
    } else {
      const gate = SAVE.gateFor(i);
      const need = Math.max(0, gate - SAVE.totalStars());
      kids.push(fitText(this, x + px(96), y + px(80),
        need > 0 ? ('NEEDS ' + need + ' MORE STARS') : 'CLEAR THE PREVIOUS LEVEL',
        px(20), '#7A6A50', FONT.display, px(330), 0));
    }

    const z = this.add.zone(x + w / 2, y + h / 2, w, h).setInteractive({ useHandCursor: unlocked });
    /* Require the press to START on this card.

       Buttons elsewhere fire on pointerdown, so tapping MAP switched to
       this scene while the finger was still down - and the release then
       landed as a pointerup on whichever card sat under it, launching a
       level. It looked like the game restarting on its own. Tracking the
       press means a release with no matching press here is ignored. */
    /* A geometry mask clips RENDERING, not input. Once the list is
       scrolled, cards that have moved above the viewport still hit-test
       where they now sit - including on top of the back button, which
       swallowed the tap and made it dead. Both handlers ignore any
       pointer outside the visible band. */
    const inView = (p) => p.y >= this.viewTop && p.y <= this.viewTop + this.viewH;
    z.on('pointerdown', (p) => { this.pressedCard = inView(p) ? i : null; });
    z.on('pointerup', (p) => {
      const wasPressedHere = this.pressedCard === i;
      this.pressedCard = null;
      if (!unlocked || this.dragged || !wasPressedHere || !inView(p)) return;
      this.scene.start('Play', { level: i });
    });
    kids.push(z);
    this.list.add(kids);
  }

  setupScroll() {
    this.dragging = false; this.dragged = false; this.vel = 0; this.pressedCard = null;
    this.input.on('pointerdown', (p) => {
      if (p.y < this.viewTop || p.y > this.viewTop + this.viewH) return;
      this.dragging = true; this.dragged = false; this.lastY = p.y; this.vel = 0;
    });
    this.input.on('pointermove', (p) => {
      if (!this.dragging) return;
      const dy = p.y - this.lastY;
      this.lastY = p.y;
      if (Math.abs(dy) > 2) this.dragged = true;
      this.vel = dy;
      this.scrollTo(this.scrollY + dy);
    });
    /* Deliberately does NOT clear pressedCard: Phaser's ordering between
       scene-level POINTER_UP and per-object GAMEOBJECT_UP is not
       guaranteed, and clearing here could null it before the card reads
       it. It is overwritten on the next press anyway. */
    this.input.on('pointerup', () => { this.dragging = false; });
    this.input.on('wheel', (p, o, dx, dy) => this.scrollTo(this.scrollY - dy * 0.6));
  }

  scrollTo(v) {
    this.scrollY = Phaser.Math.Clamp(v, this.scrollMin, 0);
    this.list.y = this.scrollY;
  }

  update() {
    // momentum after the finger lifts
    if (!this.dragging && Math.abs(this.vel) > 0.4) {
      this.vel *= 0.92;
      this.scrollTo(this.scrollY + this.vel);
    }
  }
}

/* ====================================================================
   SHOP
   ==================================================================== */
class Shop extends Phaser.Scene {
  constructor() { super('Shop'); }
  /* Reset the swipe flags on EVERY entry. setupSwipe() binds scene-level
     input handlers once per visit, guarded by swipeReady; but Phaser reuses
     the scene INSTANCE across scene.start() while destroying its input
     listeners on shutdown. A flag left true from the previous visit made the
     guard skip the re-bind, so the carousel could not be swiped again for the
     rest of the session - the dots still worked, which is what disguised it.
     `swiped` matters too: the dot handler reads it, and a stale true would
     have swallowed dot taps as well. */
  init() {
    this.tab = 'ball'; this.page = 0;
    this.swipeReady = false; this.swiped = false; this.swipeFrom = undefined;
  }

  create() {
    /* No dark scrim over the backdrop. It was there to make cream cards
       read against a dusk sky; the daylight painting needs no help, and
       the scrim only made the whole screen look overcast. */
    paintBackdrop(this);

    backButton(this, px(74), tp(84), () => this.scene.start('Home'));
    this.coinG = coinBar(this, W - px(26), tp(84));

    /* Title, outlined and flanked by stars as in the reference. A soft
       shadow alone lost the white lettering against the pale sky. */
    const title = fitText(this, W / 2, tp(182), 'SHOP', px(58), '#FFFFFF', FONT.display, px(460));
    title.setStroke('#14345C', px(9));
    title.setShadow(0, px(4), 'rgba(0,0,0,0.35)', 0, false, true);
    const sx = title.width / 2 + px(52);
    [-1, 1].forEach((d) => {
      this.add.image(W / 2 + d * sx, tp(190), 'lvIcStar').setDisplaySize(px(48), px(46));
    });

    this.hintDefault = '#0F3454';
    this.hint = fitText(this, W / 2, tp(248), 'EARN COINS BY BREAKING BRICKS',
      px(21), this.hintDefault, FONT.small, px(620));

    this.tabLayer = this.add.container(0, 0);
    this.itemLayer = this.add.container(0, 0);
    this.redraw();
  }

  /* Tabs keep their own colour - green for balls, gold for paddles - and
     the ACTIVE one is marked by a notch and full opacity. Swapping the
     colours on selection made it look like two different controls. */
  buildTabs() {
    this.tabLayer.removeAll(true);
    const spec = [
      { k: 'ball',   label: 'BALLS',   kind: 'green', icon: 'rdBall0' },
      { k: 'paddle', label: 'PADDLES', kind: 'cream', icon: 'padWood' },
    ];
    spec.forEach((t, i) => {
      const x = W / 2 + (i === 0 ? -px(158) : px(158));
      const y = tp(322);
      const on = this.tab === t.k;
      const p = pill(this, x, y, px(300), px(88), t.label, px(27), t.kind, () => {
        if (this.tab === t.k) return;
        this.tab = t.k; this.page = 0; this.redraw();
      }, t.icon);
      if (!on) { p.g.setAlpha(0.55); p.txt.setAlpha(0.75); }
      this.tabLayer.add([p.g, p.txt, p.img]);
      if (on) {
        const n = this.add.graphics();
        n.fillStyle(t.kind === 'green' ? 0x3E8B18 : 0xD98A12, 1);
        n.fillTriangle(x - px(16), y + px(42), x + px(16), y + px(42), x, y + px(66));
        this.tabLayer.add(n);
      }
    });
  }

  redraw() {
    this.itemLayer.removeAll(true);
    this.buildTabs();

    /* ------------------------------------------------------------------
       Carousel, not a grid.

       Four items in a 2x2 grid left each card too small for the art to
       read, and the second row was the first thing squeezed off a short
       screen. One card at a time gets the full width, and swiping is the
       natural gesture on a phone.
       ------------------------------------------------------------------ */
    const items = SHOP[this.tab];
    this.pageCount = items.length;
    if (this.page === undefined || this.page >= this.pageCount) this.page = 0;

    const top = tp(408);
    /* Card width and pitch are tied: at cardW = W-150 with a 50 gap the
       next card's edge landed 25px inside the screen, showing as a hard
       vertical sliver rather than a hint of a neighbour. The gap now
       exceeds the side margin, so neighbours sit fully off-screen. */
    this.cardW = W - px(230);
    this.cardH = Math.min(px(790), (H - px(176)) - top);
    this.pitch = this.cardW + px(120);
    this.dotY = top + this.cardH + px(56);

    this.track = this.add.container(0, 0);
    this.itemLayer.add(this.track);
    items.forEach((it, i) => {
      this.buildItem(it, W / 2 - this.cardW / 2 + i * this.pitch, top, this.cardW, this.cardH);
    });

    /* Page dots, and they are the tap target. The old side arrows are
       gone - the reference has none and the card now runs too wide to sit
       one either side - so the dots carry the non-swipe path instead. */
    this.dots = [];
    items.forEach((_, i) => {
      const dx = W / 2 + (i - (this.pageCount - 1) / 2) * px(48);
      const g = this.add.graphics();
      const z = this.add.zone(dx, this.dotY, px(46), px(46))
        .setInteractive({ useHandCursor: true });
      z.on('pointerdown', () => { if (!this.swiped) this.goTo(i); });
      this.itemLayer.add([g, z]);
      this.dots.push({ g: g, x: dx });
    });
    this.paintDots();

    this.layoutTrack(false);
    this.setupSwipe();
  }

  paintDots() {
    this.dots.forEach((d, i) => {
      const on = i === this.page;
      d.g.clear();
      d.g.fillStyle(0x0C2740, on ? 0.30 : 0.22);
      d.g.fillCircle(d.x, this.dotY + px(3), on ? px(15) : px(11));
      d.g.fillStyle(0xFFFFFF, on ? 1 : 0.55);
      d.g.fillCircle(d.x, this.dotY, on ? px(14) : px(10));
    });
  }

  /** Slide the track so the current page sits centred. */
  layoutTrack(animate) {
    const targetX = -this.page * this.pitch;
    if (!animate) { this.track.x = targetX; return; }
    this.tweens.add({ targets: this.track, x: targetX, duration: 220, ease: 'Cubic.easeOut' });
  }

  goTo(p) {
    const np = Phaser.Math.Clamp(p, 0, this.pageCount - 1);
    if (np === this.page) return;
    this.page = np;
    this.layoutTrack(true);
    this.paintDots();
  }

  setupSwipe() {
    if (this.swipeReady) return;      // handlers are scene-level; bind once
    this.swipeReady = true;
    this.input.on('pointerdown', (p) => {
      this.swipeFrom = p.x; this.swipeBase = this.track ? this.track.x : 0; this.swiped = false;
    });
    this.input.on('pointermove', (p) => {
      if (this.swipeFrom === undefined || !p.isDown || !this.track) return;
      const dx = p.x - this.swipeFrom;
      if (Math.abs(dx) > px(12)) this.swiped = true;
      this.track.x = this.swipeBase + dx * 0.9;
    });
    this.input.on('pointerup', (p) => {
      if (this.swipeFrom === undefined || !this.track) return;
      const dx = p.x - this.swipeFrom;
      this.swipeFrom = undefined;
      if (Math.abs(dx) < px(50)) { this.layoutTrack(true); return; }
      this.goTo(this.page + (dx < 0 ? 1 : -1));
      this.layoutTrack(true);
    });
  }

  buildItem(it, x, y, w, h) {
    const owned = SAVE.owns(this.tab, it.id);
    const equipped = SAVE.equippedId(this.tab) === it.id;
    const afford = SAVE.coins() >= it.price;
    /* panel(), not card(): the reference card is solid cream with a warm
       border, and card()'s 74%-opaque box let the landscape through. */
    const kids = [panel(this, x, y, w, h)];

    /* The item sits on a lit disc. A pale ball on a cream card is nearly
       invisible, and the paddle sprites differ only in tint. */
    const wellD = Math.min(px(380), h * 0.46, w - px(150));
    const wellY = y + h * 0.30;
    kids.push(this.add.image(x + w / 2, wellY, bakeShowcase(this, 420))
      .setDisplaySize(wellD, wellD));

    [[-0.30, -0.36, 0.050], [0.30, -0.30, 0.036], [-0.26, 0.33, 0.032]]
      .forEach(([fx, fy, fs]) => {
        kids.push(sparkle(this, x + w / 2 + w * fx, wellY + wellD * fy, w * fs, 0.85));
      });

    const isPaddle = this.tab === 'paddle';
    const art = this.add.image(x + w / 2, wellY, it.art);
    if (isPaddle) art.setDisplaySize(wellD * 0.80, wellD * 0.22);
    else          art.setDisplaySize(wellD * 0.52, wellD * 0.52);
    if (!owned) art.setAlpha(0.55);
    kids.push(art);

    kids.push(fitText(this, x + w / 2, y + h * 0.615, it.name, px(50),
      '#123A6B', FONT.display, w - px(70)));
    kids.push(fitText(this, x + w / 2, y + h * 0.705, it.desc, px(25),
      '#4A3520', FONT.small, w - px(80)));

    const label = equipped ? 'EQUIPPED' : owned ? 'EQUIP' : (it.price === 0 ? 'FREE' : '  ' + it.price);
    const kind = equipped ? 'grey' : (owned || afford) ? 'green' : 'cream';
    const btnY = y + h - px(96);
    const btn = pill(this, x + w / 2, btnY, w - px(110), px(104),
      label, px(32), kind, () => {
        if (equipped) return;
        if (owned) { SAVE.equip(this.tab, it.id); this.refreshAll(); return; }
        if (SAVE.buy(this.tab, it.id)) { this.refreshAll(); return; }
        this.hint.setText('NOT ENOUGH COINS');
        this.hint.setColor('#B4231A');
        this.time.delayedCall(1200, () => {
          this.hint.setText('EARN COINS BY BREAKING BRICKS');
          this.hint.setColor(this.hintDefault);
        });
      });
    /* Dim the FACE when unaffordable, never the label - fading the text
       made the one number the player needs unreadable.

       The label keeps pill()'s white-on-dark-shadow too. Recolouring it to
       #B4522F put warm brown on a dimmed gold face, which was the same
       low-contrast problem by another route; green-vs-gold plus the dimmed
       face already carry "you cannot afford this". */
    if (!owned && !afford && it.price > 0) {
      btn.g.setAlpha(0.62);
      btn.txt.setStroke('rgba(90,42,10,0.9)', px(5));
    }
    kids.push(btn.g, btn.txt, btn.img);

    if (!owned && it.price > 0) {
      const ci = this.add.image(btn.txt.x - btn.txt.width / 2 - px(26), btnY - px(3), 'lvIcCoin')
        .setDisplaySize(px(52), px(54));
      if (!afford) ci.setAlpha(0.6);
      kids.push(ci);
    }
    this.track.add(kids);
  }

  refreshAll() {
    this.coinG.destroy();
    this.coinG = coinBar(this, W - px(26), tp(84));
    this.redraw();
  }
}

/* ====================================================================
   PLAY
   ==================================================================== */
class Play extends Phaser.Scene {
  constructor() { super('Play'); }

  init(data) { this.levelIndex = (data && data.level) || 0; }

  create() {
    this.laserT = 0; this.slowT = 0; this.wideT = 0; this.lastShot = 0;
    this.launch = true; this.levelScore = 0; this.levelCoins = 0;
    this.overlay = null;

    /* Start of a NEW run. create() runs only on scene.start('Play'), i.e.
       when the player enters from Home or Level Select - advancing with NEXT
       calls startLevel() and retrying calls retryLevel(), neither of which
       re-runs create(). So resetting here rewinds the run score exactly when
       a run genuinely begins, and never mid-run.

       Without this, RUN.score (module-level, so it outlives the scene)
       carried into every menu re-entry: clearing level 1 twice via MAP banked
       a personal best of double one level's score, and repeating it inflated
       the best without limit. Same defect retryLevel() already guards
       against, reached by the other door. */
    RUN.score = 0;

    // Phaser reuses the scene instance across scene.start(), but every
    // object from the previous visit was destroyed on shutdown. Drop the
    // stale handles so buildLevel creates fresh groups rather than
    // clearing dead ones.
    this.bricksGroup = null; this.dropsGroup = null; this.boltsGroup = null;
    this.extraBalls = [];
    this.extraColliders = [];      // FIX 3: see applyPowerUp

    this.mods = SAVE.mods();
    /* Equipping a ball in the shop had no visible effect: play hardcoded
       the 'ball' texture, so a purchased EMBER or BOLT looked identical to
       CLASSIC. Resolve the equipped art here and use it everywhere a ball
       is created, including multi-ball spawns. */
    this.ballTex   = shopItem('ball',   SAVE.equippedId('ball')).art;
    this.paddleTex = shopItem('paddle', SAVE.equippedId('paddle')).art;
    if (!this.textures.exists(this.ballTex)) this.ballTex = 'ball';
    if (!this.textures.exists(this.paddleTex)) this.paddleTex = 'paddle';

    this.bgBands = [];
    this.setBackdrop(this.levelIndex);

    /* v1 set the bottom bound 400 units past the world height AND disabled
       downward collision - two mechanisms for one job, which made the
       intent unreadable. checkCollision.down = false alone is what lets a
       missed ball fall out; the bounds are just the play box. */
    this.physics.world.setBounds(px(8), px(232), W - px(16), H - px(232));
    this.physics.world.checkCollision.down = false;

    this.buildHUD();
    this.buildPaddleAndBall();
    this.buildLevel(this.levelIndex);

    this.dropsGroup = this.physics.add.group();
    this.boltsGroup = this.physics.add.group();

    this.physics.add.collider(this.ball, this.bricksGroup, this.onBrickHit, null, this);
    this.physics.add.collider(this.ball, this.paddle, this.onPaddleHit, null, this);
    this.physics.add.overlap(this.paddle, this.dropsGroup, this.onDropCaught, null, this);
    this.physics.add.overlap(this.boltsGroup, this.bricksGroup, this.onBoltHit, null, this);

    this.input.on('pointermove', (p) => { this.pointerX = Phaser.Math.Clamp(p.x, 0, W); });
    this.input.on('pointerdown', (p) => {
      this.pointerX = Phaser.Math.Clamp(p.x, 0, W);
      if (this.overlay) return;
      if (this.launch) this.launchBall();
    });
    this.pointerX = this.paddle.x;

    this.hudDirty = true;
  }

  /* ---------------- HUD ----------------
     The capsules, pause key, gear and progress bar are the supplied art.
     Each one had its live value painted in - "2,430", three fixed hearts,
     a 60% fill - so those regions were blanked when the assets were cut
     and the real values are drawn over them here. The fractions below are
     where each value sat in its source image. */
  buildHUD() {
    const capCy = tp(84);

    /* score */
    const scW = px(318), scH = scW * (122 / 343), scX = px(40);
    this.add.image(scX, capCy, 'lvScoreCap').setDisplaySize(scW, scH).setOrigin(0, 0.5);
    this.scoreText = fitText(this, scX + scW * 0.627, capCy - scH / 2 + scH * 0.607,
      '0', px(38), '#2B3A4A', FONT.display, scW * 0.52);

    /* lives */
    const lvW = px(268), lvH = lvW * (122 / 303), lvX = px(392);
    this.add.image(lvX, capCy, 'lvLivesCap').setDisplaySize(lvW, lvH).setOrigin(0, 0.5);
    const hy = capCy - lvH / 2 + lvH * 0.631, hs = lvW * 0.205;
    this.hearts = [0.304, 0.528, 0.752].map((f) =>
      this.add.image(lvX + lvW * f, hy, 'heart').setDisplaySize(hs, hs));
    /* The EXTRA LIFE pickup allows up to 5 lives but the capsule art has
       exactly three heart slots, so a 4th and 5th life were awarded and then
       shown nowhere - the pickup read as doing nothing. Rather than overflow
       a capsule never cut for five, surplus lives are counted in a small +N
       in the capsule's own right-hand margin (the last heart ends at 0.752 of
       its width), hidden whenever lives are 3 or fewer. */
    this.livesPlus = this.add.text(lvX + lvW * 0.95, hy, '',
      { fontFamily: FONT.button, fontSize: fpx(20) + 'px', color: '#FFD86B' })
      .setOrigin(0.5).setVisible(false);
    this.livesPlus.setShadow(0, px(2), 'rgba(0,0,0,0.55)', 0, false, true);
    /* refit() expects the two fields fitText() stamps on. This Text is built
       directly - it needs no shrink-to-fit - so supply them here. */
    this.livesPlus.baseSize = fpx(20);
    this.livesPlus.maxW = lvW * 0.16;

    /* pause */
    const ps = px(94);
    const pb = this.add.image(px(806), capCy, 'lvPause').setDisplaySize(ps, ps * (121 / 115));
    const pz = this.add.zone(px(806), capCy, ps * 1.2, ps * 1.2)
      .setInteractive({ useHandCursor: true });
    pz.on('pointerdown', () => {
      this.tweens.add({ targets: pb, y: capCy + px(4), duration: 60, yoyo: true });
      if (!this.overlay) this.showPause();
    });

    /* Outlined, not just shadowed. A drop shadow alone was enough over the
       old dusk-toned generated backdrops, but the level paintings put pale
       sky and sunlit water behind this text and white-on-pale vanished. */
    /* Title block and brick field both hang off the bottom of the capsule
       row rather than off fixed offsets. Anchoring them to the top edge
       meant the cutout inset pushed the title down into the bricks, which
       start at a fixed logical 300 and never needed to move at all. */
    const hudBottom = capCy + scH / 2;
    this.gridTop = Math.max(px(300), hudBottom + px(128));

    this.levelTitle = fitText(this, W / 2, hudBottom + px(46), '', px(30), '#FFF8E6', FONT.display, px(560));
    this.levelTitle.setStroke('rgba(12,22,38,0.85)', px(5));
    this.levelTitle.setShadow(0, px(3), 'rgba(0,0,0,0.55)', 0, false, true);
    this.levelSub = fitText(this, W / 2, hudBottom + px(88), '', px(20), '#E4EDFA', FONT.small, px(560));
    this.levelSub.setStroke('rgba(12,22,38,0.8)', px(4));
    this.levelSub.setShadow(0, px(2), 'rgba(0,0,0,0.5)', 0, false, true);

    /* FIX 1 (the big one).
       v1 destroyed and recreated the progress meter and every power-up
       badge on EVERY frame from update(), plus re-ran fitText's shrink
       loop on four Text objects. Under the Canvas renderer each setText
       re-rasterises that Text to its own canvas, so this was ~10 object
       allocations and several rasterisations per frame for a HUD that
       changes a couple of times a second.

       Now: the meter is built once, only the fill graphic is redrawn, the
       badges are built once and shown/hidden, and refit() early-returns
       when the string is unchanged. */
    const prW = px(672), prH = prW * (85 / 748), prCy = bp(92);
    const prX = W / 2 - prW / 2;
    this.add.image(W / 2, prCy, 'lvProg').setDisplaySize(prW, prH);
    /* Groove and percent position, as fractions of the source bar. */
    this.progGeo = {
      x: prX + prW * 0.457, w: prW * 0.388,
      y: prCy - prH / 2 + prH * 0.306, h: prH * 0.376,
      px: prX + prW * 0.892, py: prCy,
    };
    this.progFill = this.add.graphics();
    this.progFrac = -1;
    this.progPct = this.add.text(this.progGeo.px, this.progGeo.py, '0%',
      { fontFamily: FONT.button, fontSize: fpx(24) + 'px', color: '#FFC63E' })
      .setOrigin(0.5);

    this.badges = ['LASER', 'WIDE', 'SLOW'].map((name, i) => {
      const x = px(300 + i * 108), y = bp(450);
      const g = this.add.graphics();
      g.fillStyle(0x1b2440, 0.85); g.fillRoundedRect(x, y, px(96), px(26), px(13));
      const f = this.add.graphics();
      const t = fitText(this, x + px(48), y + px(13), name, px(15), COL.text, FONT.small, px(84));
      const o = { g: g, f: f, t: t, x: x, y: y, frac: -1 };
      [g, f, t].forEach((n) => n.setVisible(false));
      return o;
    });

    this.launchPrompt = this.add.text(W / 2, bp(484), 'TAP TO LAUNCH',
      { fontFamily: FONT.display, fontSize: fpx(26) + 'px', color: '#FFFFFF' }).setOrigin(0.5);
    this.launchPrompt.setStroke('rgba(12,22,38,0.85)', px(5));
    this.launchPrompt.setShadow(0, px(3), 'rgba(0,0,0,0.6)', 0, false, true);
  }

  refreshHUD() {
    refit(this.scoreText, RUN.score.toLocaleString('en-US'));
    for (let i = 0; i < 3; i++) {
      const want = i < RUN.lives ? 'heart' : 'heartEmpty';
      if (this.hearts[i].texture.key !== want) this.hearts[i].setTexture(want);
    }
    const spare = Math.max(0, RUN.lives - 3);
    if (this.livesPlus.visible !== (spare > 0)) this.livesPlus.setVisible(spare > 0);
    if (spare > 0) refit(this.livesPlus, '+' + spare);
    refit(this.levelTitle, LEVELS[this.levelIndex].name);
    refit(this.levelSub, 'LEVEL ' + (this.levelIndex + 1) + ' OF ' + LEVEL_COUNT +
      '  ·  ' + TIERS[tierOf(this.levelIndex)].name);
    this.launchPrompt.setVisible(this.launch && !this.overlay);

    const frac = this.totalBricks ? 1 - this.bricksLeft / this.totalBricks : 0;
    if (Math.abs(frac - this.progFrac) > 0.001) {
      this.progFrac = frac;
      const g = this.progGeo;
      this.progFill.clear();
      if (frac > 0.001) {
        this.progFill.fillStyle(0x3AA9FF, 1);
        this.progFill.fillRoundedRect(g.x, g.y, Math.max(g.h, g.w * frac), g.h, g.h / 2);
        this.progFill.fillStyle(0x8FD4FF, 0.55);
        this.progFill.fillRoundedRect(g.x + g.h * 0.16, g.y + g.h * 0.14,
          Math.max(g.h * 0.5, g.w * frac - g.h * 0.32), g.h * 0.30, g.h * 0.15);
      }
      this.progPct.setText(Math.round(frac * 100) + '%');
    }

    const act = [this.laserT / 9, this.wideT / 11, this.slowT / 9];
    this.badges.forEach((b, i) => {
      const on = act[i] > 0;
      if (b.g.visible !== on) [b.g, b.f, b.t].forEach((n) => n.setVisible(on));
      if (on && Math.abs(act[i] - b.frac) > 0.01) {
        b.frac = act[i];
        b.f.clear();
        b.f.fillStyle(0xf5ba30, 1);
        b.f.fillRoundedRect(b.x + px(2), b.y + px(2), Math.max(px(8), px(92) * Math.min(1, act[i])), px(22), px(11));
      }
    });
  }

  /* The level backdrop: two sprites off the painting, or one baked image
     for the levels that still fall back to the procedural generator.
     Rebuilt rather than re-textured - it is two objects, and the previous
     setTexture path had to re-apply setDisplaySize because the painted and
     generated backdrops were different sizes. */
  setBackdrop(n) {
    if (this.bgBands) this.bgBands.forEach((o) => o.destroy());
    const art = 'lvbg' + (LVBG[n] || 0);
    if (this.textures.exists(art)) {
      this.bgBands = paintingBands(this, art, LVBG_SKY_FRAC);
    } else {
      this.bgBands = [this.add.image(0, 0, bgTexture(this, n, 900, 1600))
        .setOrigin(0).setDisplaySize(W, H)];
    }
    this.bgBands.forEach((o) => o.setDepth(-10));
  }

  /* ---------------- level construction ---------------- */
  buildLevel(n) {
    this.levelIndex = n;
    const lv = LEVELS[n];
    this.setBackdrop(n);

    // Reuse the SAME group instance: the ball's collider was bound to this
    // object once in create(), so replacing it would leave the ball
    // colliding with an orphaned empty group.
    if (this.bricksGroup) this.bricksGroup.clear(true, true);
    else this.bricksGroup = this.physics.add.staticGroup();

    /* y comes from this.gridTop, set in buildHUD - it yields to the HUD
       and title block on a device with a display cutout. */
    const G = { x: 44, cols: 6, bw: 130, bh: 54, gap: 12 };
    lv.rows.forEach((row, r) => {
      for (let c = 0; c < G.cols; c++) {
        const ch = row[c] || '.';
        if (ch === '.') continue;
        const x = px(G.x + c * (G.bw + G.gap) + G.bw / 2);
        const y = this.gridTop + px(r * (G.bh + G.gap) + G.bh / 2);
        let key, hp, type, colourIdx = null;
        if (ch === 'S') { key = 'brickStone'; hp = Infinity; type = 'stone'; }
        else if (ch === 'D') { colourIdx = (r + c) % 6; key = 'brick' + colourIdx; hp = 2; type = 'damaged'; }
        else if (ch === 'B') { key = 'brickBonus'; hp = 1; type = 'bonus'; }
        else { colourIdx = parseInt(ch, 10) - 1; key = 'brick' + colourIdx; hp = 1; type = 'brick'; }

        const b = this.bricksGroup.create(x, y, key).setDisplaySize(px(G.bw), px(G.bh));
        b.setData({ hp: hp, type: type, colourIdx: colourIdx, maxHp: hp });
        b.refreshBody();
        if (type === 'bonus') {
          this.tweens.add({ targets: b, alpha: 0.72, duration: 620, yoyo: true, repeat: -1 });
        }
      }
    });

    /* FIX 2: keep a running count instead of filtering the whole group on
       every brick hit AND every HUD refresh. */
    this.totalBricks = this.bricksGroup.getChildren()
      .filter((b) => b.getData('hp') !== Infinity).length;
    this.bricksLeft = this.totalBricks;

    if (this.dropsGroup) {
      // FIX 4a: clear(true,true) destroys the drops but not the glow
      // sprites parented alongside them.
      this.dropsGroup.getChildren().slice().forEach((d) => { if (d.glow) d.glow.destroy(); });
      this.dropsGroup.clear(true, true);
    }
    if (this.boltsGroup) this.boltsGroup.clear(true, true);
    this.destroyExtraBalls();

    this.laserT = 0; this.slowT = 0; this.wideT = 0;
    this.physics.world.timeScale = 1;
    this.levelScore = 0; this.levelCoins = 0;
    RUN.lives = LIVES_PER_LEVEL;

    this.paddleW = Math.round(266 * paddleScaleFor(n) * (this.mods.widthMul || 1));
    if (this.paddle) {
      this.paddle.setTexture(this.paddleTex).setDisplaySize(px(this.paddleW), px(70));
      this.syncPaddleBody();
    }
    this.resetBall();
    this.progFrac = -1;
    this.refreshHUD();
  }

  /* FIX 3: every extra ball registers two colliders. v1 destroyed the ball
     but never the colliders, so a long session with repeated multi-ball
     pickups accumulated dead collider objects in the physics world. */
  destroyExtraBalls() {
    (this.extraColliders || []).forEach((c) => this.physics.world.removeCollider(c));
    this.extraColliders = [];
    (this.extraBalls || []).forEach((b) => b.destroy());
    this.extraBalls = [];
  }

  /* Resize the paddle's physics body to match its CURRENT texture.

     setTexture() swaps the frame, but an Arcade body keeps the
     sourceWidth it was created with. The wide paddle is a 693px frame
     where the default is 485, so after the WIDE power-up the body stayed
     narrow while the sprite grew - the ball passed through the new ends
     and fell. refreshBody() does not fix this: it belongs to STATIC
     bodies and is a no-op here. */
  syncPaddleBody() {
    const b = this.paddle && this.paddle.body;
    if (!b) return;
    b.setSize(this.paddle.width, this.paddle.height, true);
  }

  buildPaddleAndBall() {
    this.paddleW = Math.round(266 * paddleScaleFor(this.levelIndex) * (this.mods.widthMul || 1));
    this.paddle = this.physics.add.image(W / 2, bp(349), this.paddleTex)
      .setDisplaySize(px(this.paddleW), px(70)).setImmovable(true);
    this.paddle.body.allowGravity = false;

    this.ball = this.physics.add.image(W / 2, bp(404), this.ballTex).setDisplaySize(px(46), px(46));
    this.ball.setCircle(this.ball.width / 2);
    this.ball.setCollideWorldBounds(true);
    this.ball.setBounce(1, 1);
    this.ball.body.allowGravity = false;
  }

  resetBall() {
    this.launch = true;
    this.ball.setVelocity(0, 0);
    this.ball.setPosition(this.paddle.x, bp(404));
    this.stickyLeft = this.mods.sticky || 0;
  }

  launchBall() {
    this.launch = false;
    const a = (-Math.PI / 2) + (Math.random() - 0.5) * 0.5;
    // per-level speed, plus any equipped-ball modifier
    const sp = px(speedFor(this.levelIndex)) * (this.mods.speedMul || 1);
    this.ball.setVelocity(Math.cos(a) * sp, Math.sin(a) * sp);
  }

  /* ---------------- collisions ---------------- */
  onPaddleHit(ball, paddle) {
    const off = Phaser.Math.Clamp((ball.x - paddle.x) / (paddle.displayWidth / 2), -1, 1);
    const ang = off * 1.05 - Math.PI / 2;   // clamped so vy is always upward
    const cur = Math.hypot(ball.body.velocity.x, ball.body.velocity.y);
    // ceiling scales with the level, or late levels get clamped instantly
    const cap = px(speedCapFor(this.levelIndex)) * (this.mods.speedMul || 1);
    const sp = Math.min(cap, cur * 1.012);
    ball.setVelocity(Math.cos(ang) * sp, Math.sin(ang) * sp);
  }

  onBrickHit(ball, brick) { this.damageBrick(brick); }
  onBoltHit(bolt, brick) { bolt.destroy(); this.damageBrick(brick); }

  onDropCaught(paddle, drop) {
    this.applyPowerUp(drop.getData('kind'));
    // FIX 4b: v1 destroyed the drop but not its additive glow sprite, so
    // every power-up the player actually CAUGHT left an orphaned glow
    // parked at the catch point for the rest of the level.
    if (drop.glow) drop.glow.destroy();
    drop.destroy();
  }

  damageBrick(brick) {
    const hp = brick.getData('hp');
    if (hp === Infinity) { this.cameras.main.shake(70, 0.002); return; }

    // EMBER ball: a cracked brick goes down in one more hit regardless
    const lethal = (this.mods.crackThrough && hp < brick.getData('maxHp')) ? hp : 1;
    const nhp = hp - lethal;
    brick.setData('hp', nhp);
    this.flashBrick(brick);

    if (nhp <= 0) {
      const type = brick.getData('type');
      const pts = Math.round((type === 'bonus' ? 250 : 100) * (this.mods.scoreMul || 1));
      RUN.score += pts; this.levelScore += pts;
      const coins = type === 'bonus' ? COIN_PER_BONUS_BRICK : COIN_PER_BRICK;
      this.levelCoins += coins;
      // FIX 5: an infinite alpha tween on a destroyed target
      this.tweens.killTweensOf(brick);
      if (Math.random() < dropChanceFor(this.levelIndex)) this.spawnDrop(brick.x, brick.y);
      brick.destroy();
      this.bricksLeft--;
      if (this.bricksLeft <= 0) { this.refreshHUD(); this.showComplete(); }
    } else {
      const pts = Math.round(40 * (this.mods.scoreMul || 1));
      RUN.score += pts; this.levelScore += pts;
      brick.setTexture('brickCracked' + brick.getData('colourIdx'));
    }
  }

  flashBrick(brick) {
    /* A white rectangle rather than setTintFill: tint fill is another
       thing the CANVAS renderer does not honour, so the hit flash simply
       did not appear. A rect is renderer-agnostic. */
    const fx = this.add.rectangle(brick.x, brick.y, brick.displayWidth, brick.displayHeight, 0xfff2cf)
      .setAlpha(0.6).setBlendMode(Phaser.BlendModes.ADD);
    this.tweens.add({ targets: fx, alpha: 0, duration: 140, onComplete: () => fx.destroy() });
  }

  spawnDrop(x, y) {
    const kind = Phaser.Math.Between(0, POWERUPS.length - 1);
    const key = 'pu' + kind;
    const d = this.dropsGroup.create(x, y, key).setDisplaySize(px(132), px(35));
    d.setData('kind', kind);
    d.body.allowGravity = false;
    d.setVelocityY(px(240));
    d.glow = this.add.image(x, y, key).setDisplaySize(px(198), px(66))
      .setAlpha(0.26).setBlendMode(Phaser.BlendModes.ADD).setDepth(-1);
    this.tweens.add({ targets: d, angle: { from: -4, to: 4 }, duration: 700,
      yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });
  }

  applyPowerUp(kind) {
    const k = POWERUPS[kind].key;
    if (k === 'multi') {
      // cap the swarm - v1 let this stack without limit
      if (this.extraBalls.length >= 6) { RUN.score += 50; return; }
      const vx = this.ball.body.velocity.x, vy = this.ball.body.velocity.y;
      const sp = Math.hypot(vx, vy) || px(speedFor(this.levelIndex));
      [-0.5, 0.5].forEach((d) => {
        const a = Math.atan2(vy, vx) + d;
        const nb = this.physics.add.image(this.ball.x, this.ball.y, this.ballTex).setDisplaySize(px(46), px(46));
        nb.setCircle(nb.width / 2); nb.setCollideWorldBounds(true);
        nb.setBounce(1, 1); nb.body.allowGravity = false;
        nb.setVelocity(Math.cos(a) * sp, Math.sin(a) * sp);
        // FIX 3: keep the collider handles so they can be removed later
        this.extraColliders.push(this.physics.add.collider(nb, this.bricksGroup, this.onBrickHit, null, this));
        this.extraColliders.push(this.physics.add.collider(nb, this.paddle, this.onPaddleHit, null, this));
        this.extraBalls.push(nb);
      });
    } else if (k === 'life') {
      RUN.lives = Math.min(5, RUN.lives + 1);
    } else if (k === 'laser') {
      this.laserT = 9;
    } else if (k === 'wide') {
      this.wideT = 11;
      this.paddle.setTexture('padWide')
        .setDisplaySize(px(Math.round(this.paddleW * 1.43)), px(70));
      this.syncPaddleBody();
    } else if (k === 'slow') {
      this.slowT = 9;
      this.physics.world.timeScale = 1.6;
    }
    RUN.score += 50;
  }

  loseLife() {
    RUN.lives--;
    this.refreshHUD();
    if (RUN.lives <= 0) { this.showGameOver(); return; }
    this.resetBall();
  }

  /* ---------------- update ---------------- */
  update(time, delta) {
    if (this.overlay) return;
    const dt = delta / 1000;

    /* The paddle tracks the finger directly.

       It used to ease in: x += (target - x) * dt * 18. At 60fps that is 0.30
       per frame, so the paddle reached the finger about 150ms late - which
       reads as lag, not as smoothing. The dt * 18 form is not frame-rate
       independent either: as dt grows the factor clamps at 1, so on a slow
       frame the paddle snaps instead of gliding, and the motion changes
       character with the frame rate. Pointer position is already sampled
       fresh every frame, so assigning it is both smoother and exact. */
    const half = this.paddle.displayWidth / 2;
    this.paddle.x = Phaser.Math.Clamp(this.pointerX, half + px(8), W - half - px(8));

    if (this.launch) this.ball.setPosition(this.paddle.x, bp(404));

    // MAGNET ball: a gentle pull toward the nearest brick
    if (this.mods.homing && !this.launch) {
      const near = this.nearestBrick(this.ball.x, this.ball.y);
      if (near) {
        const v = this.ball.body.velocity;
        const sp = Math.hypot(v.x, v.y);
        const want = Math.atan2(near.y - this.ball.y, near.x - this.ball.x);
        const cur = Math.atan2(v.y, v.x);
        const a = cur + Phaser.Math.Angle.Wrap(want - cur) * this.mods.homing * dt;
        this.ball.setVelocity(Math.cos(a) * sp, Math.sin(a) * sp);
      }
    }

    if (this.laserT > 0) {
      this.laserT -= dt;
      if (time - this.lastShot > 380) {
        this.lastShot = time;
        [this.paddle.x - half + px(22), this.paddle.x + half - px(22)].forEach((bx) => {
          const bolt = this.boltsGroup.create(bx, this.paddle.y - px(10), 'bolt')
            .setDisplaySize(px(12), px(34));
          bolt.body.allowGravity = false;
          bolt.setVelocityY(-px(900));
        });
      }
    }
    if (this.wideT > 0) {
      this.wideT -= dt;
      if (this.wideT <= 0) {
        // back to the EQUIPPED paddle, not the default one
        this.paddle.setTexture(this.paddleTex).setDisplaySize(px(this.paddleW), px(70));
        this.syncPaddleBody();
      }
    }
    if (this.slowT > 0) {
      this.slowT -= dt;
      if (this.slowT <= 0) this.physics.world.timeScale = 1;
    }

    // CANNON paddle
    if (this.mods.autoFire) {
      this.autoT = (this.autoT || 0) + dt;
      if (this.autoT >= this.mods.autoFire) {
        this.autoT = 0;
        const bolt = this.boltsGroup.create(this.paddle.x, this.paddle.y - px(10), 'bolt')
          .setDisplaySize(px(14), px(38));
        bolt.body.allowGravity = false;
        bolt.setVelocityY(-px(900));
      }
    }

    this.boltsGroup.getChildren().slice().forEach((bo) => { if (bo.y < px(220)) bo.destroy(); });
    this.dropsGroup.getChildren().slice().forEach((d) => {
      if (d.glow) d.glow.setPosition(d.x, d.y);
      if (d.y > H) { if (d.glow) d.glow.destroy(); d.destroy(); }
    });

    if (this.ball.y - this.ball.displayHeight / 2 > H) this.loseLife();
    this.extraBalls.slice().forEach((b) => {
      if (b.y - b.displayHeight / 2 > H) {
        b.destroy();
        this.extraBalls.splice(this.extraBalls.indexOf(b), 1);
      }
    });

    this.refreshHUD();
  }

  nearestBrick(x, y) {
    let best = null, bd = Infinity;
    this.bricksGroup.getChildren().forEach((b) => {
      if (!b.active || b.getData('hp') === Infinity) return;
      const d = (b.x - x) * (b.x - x) + (b.y - y) * (b.y - y);
      if (d < bd) { bd = d; best = b; }
    });
    return best;
  }

  /* ---------------- overlays ---------------- */
  dim() {
    if (this.launchPrompt) this.launchPrompt.setVisible(false);
    return this.add.rectangle(W / 2, H / 2, W, H, 0x070a12, 0.68).setDepth(50);
  }

  clearOverlay() {
    if (this.overlay) { this.overlay.forEach((o) => o.destroy()); this.overlay = null; }
    this.physics.world.resume();
  }

  /* Every popup: cream panel, blue ribbon straddling its top edge, live
     title. The sheet's ribbon had "LEVEL COMPLETE" painted into it, so it
     was blanked at build time and the title is drawn on top - which is
     what lets PAUSED and OUT OF LIVES share the same banner. */
  popupBase(items, title, cy, h) {
    const top = px(cy - h / 2);
    items.push(panel(this, W / 2 - px(280), top, px(560), px(h)).setDepth(51));
    popupRibbon(this, W / 2, top, title).forEach((o) => items.push(o));
  }

  /* The stats box, with the divider lines drawn live. The sheet's box has
     three baked in at fixed spacing, which only ever suits four rows -
     PAUSED has three and OUT OF LIVES has three or four. */
  rowBox(items, y0, y1, rows) {
    items.push(card(this, W / 2 - px(250), px(y0), px(500), px(y1 - y0)).setDepth(51));
    if (rows > 1) {
      const g = this.add.graphics().setDepth(52);
      g.fillStyle(0xC9A96A, 0.34);
      for (let i = 1; i < rows; i++) {
        g.fillRect(W / 2 - px(226), px(y0 + (y1 - y0) * i / rows), px(452), Math.max(1, px(1.5)));
      }
      items.push(g);
    }
  }

  row(items, label, value, y, icon) {
    let lx = W / 2 - px(224);
    if (icon) {
      items.push(this.add.image(lx + px(20), px(y), icon)
        .setDisplaySize(px(40), px(40)).setDepth(53));
      lx += px(52);
    }
    items.push(this.add.text(lx, px(y), label,
      { fontFamily: FONT.button, fontSize: fpx(21) + 'px', color: '#4A3520' })
      .setOrigin(0, 0.5).setDepth(52));
    items.push(this.add.text(W / 2 + px(224), px(y), value,
      { fontFamily: FONT.display, fontSize: fpx(24) + 'px', color: '#2B3A4A' })
      .setOrigin(1, 0.5).setDepth(52));
  }

  showPause() {
    this.physics.world.pause();
    const items = [this.dim()];
    this.popupBase(items, 'PAUSED', 720, 400);
    this.rowBox(items, 604, 796, 3);
    this.row(items, 'SCORE', RUN.score.toLocaleString('en-US'), 636, 'lvIcStar');
    this.row(items, 'LIVES LEFT', String(Math.max(0, RUN.lives)), 700, 'heart');
    this.row(items, 'COINS EARNED', String(this.levelCoins), 764, 'lvIcCoin');

    const by = 858;   // panel ends at 920
    /* RESUME is the primary action here - it is what nearly every pause
       ends with - so it gets the width, the play glyph and the green,
       while MAP steps back to a narrower secondary. Previously the two
       were identical in size and read as equal choices. */
    const resume = pill(this, W / 2 - px(112), px(by), px(266), px(96), 'RESUME', px(26), 'green',
      () => this.clearOverlay(), 'icPlay');
    const map = pill(this, W / 2 + px(146), px(by), px(186), px(88), 'MAP', px(24), 'cream',
      () => { this.clearOverlay(); this.scene.start('LevelSelect'); });
    [resume, map].forEach((r) => { r.img.setDepth(52); r.txt.setDepth(53); items.push(r.img, r.txt, r.g); });
    this.overlay = items;
  }

  showComplete() {
    this.physics.world.pause();
    const stars = starsEarned(RUN.lives, LIVES_PER_LEVEL);
    const res = SAVE.completeLevel(this.levelIndex, stars, RUN.score, this.levelCoins);
    const isLast = this.levelIndex >= LEVEL_COUNT - 1;

    const items = [this.dim()];
    this.popupBase(items, isLast ? 'ALL LEVELS CLEAR' : 'LEVEL COMPLETE', 726, 520);

    /* Three big stars riding above the ribbon, the middle one larger and
       raised. Earned stars pop in turn.

       The pop overshoots from full size rather than growing in from zero:
       scaling up from 0 means a star that never gets its tween - an
       interrupted overlay, a dropped frame budget - stays invisible, and
       the count of stars is the whole point of this screen. */
    for (let i = 0; i < 3; i++) {
      const big = i === 1;
      const d = big ? px(136) : px(112);
      const st = this.add.image(W / 2 - px(126) + i * px(126), px(big ? 344 : 368),
        i < stars ? 'lvStar' : 'lvStarOff')
        .setDisplaySize(d, d * (150 / 147)).setDepth(52);
      if (i < stars) {
        this.tweens.add({ targets: st, scaleX: st.scaleX * 1.22, scaleY: st.scaleY * 1.22,
          duration: 190, delay: 120 + i * 140, yoyo: true, ease: 'Quad.easeOut' });
      }
      items.push(st);
    }

    /* Row block filling the panel the way the reference does - it starts
       just under the ribbon and takes a little over half the panel's
       height, rather than leaving a dead band below the banner. */
    this.rowBox(items, 566, 852, 4);
    this.row(items, 'LEVEL SCORE', this.levelScore.toLocaleString('en-US'), 602, 'lvIcStar');
    this.row(items, 'COINS EARNED', '+' + (this.levelCoins + COIN_LEVEL_CLEAR), 673, 'lvIcCoin');
    this.row(items, 'TOTAL SCORE', RUN.score.toLocaleString('en-US'), 745, 'lvIcTrophy');
    this.row(items, 'BEST SCORE', SAVE.bestScore().toLocaleString('en-US'), 816, 'lvIcCrown');

    // If the next level sits behind a star gate the player has not met,
    // say so here rather than letting them tap NEXT into a locked level.
    const nextIdx = this.levelIndex + 1;
    const nextOpen = !isLast && SAVE.isUnlocked(nextIdx);
    if (!isLast && !nextOpen) {
      const need = SAVE.gateFor(nextIdx) - SAVE.totalStars();
      items.push(fitText(this, W / 2, px(872), 'NEXT TIER NEEDS ' + need + ' MORE STARS',
        px(20), '#B4522F', FONT.display, px(440)).setDepth(54));
    }

    const cby = 918;  // panel ends at 986
    const map = pill(this, W / 2 - px(180), px(cby), px(172), px(88), 'MAP', px(22), 'cream',
      () => { this.clearOverlay(); this.scene.start('LevelSelect'); }, 'lvIcMap');
    const replay = pill(this, W / 2, px(cby), px(172), px(88), 'REPLAY', px(22), 'blue',
      () => { this.clearOverlay(); this.retryLevel(); }, 'lvIcReplay');
    const next = pill(this, W / 2 + px(180), px(cby), px(172), px(88),
      isLast ? 'FINISH' : 'NEXT', px(22), (isLast || nextOpen) ? 'green' : 'grey', () => {
        this.clearOverlay();
        if (isLast || !nextOpen) { this.scene.start('LevelSelect'); return; }
        RUN.level = nextIdx;
        this.startLevel(nextIdx);
      }, 'lvIcNext');
    [map, replay, next].forEach((r) => {
      r.img.setDepth(52); r.txt.setDepth(54); items.push(r.img, r.txt, r.g);
    });
    this.overlay = items;
  }

  showGameOver() {
    this.physics.world.pause();
    const items = [this.dim()];
    this.popupBase(items, 'OUT OF LIVES', 724, 470);

    const isBest = RUN.score > 0 && RUN.score >= SAVE.bestScore();
    /* One box. There were two overlapping rowBox calls here, 58px apart,
       which drew a visibly doubled edge behind the rows. */
    /* Row block lifted 24px so the personal-best line has somewhere to go:
       at 574-766 it ended 18px above TRY AGAIN and the badge landed on
       top of the button. */
    this.rowBox(items, 550, 742, 3);
    this.row(items, 'SCORE', RUN.score.toLocaleString('en-US'), 582, 'lvIcStar');
    this.row(items, 'LEVEL', (this.levelIndex + 1) + ' / ' + LEVEL_COUNT, 646, 'lvIcTrophy');
    this.row(items, 'BEST SCORE', SAVE.bestScore().toLocaleString('en-US'), 710, 'lvIcCrown');
    if (isBest) {
      items.push(fitText(this, W / 2, px(766), 'NEW PERSONAL BEST', px(22), '#B47D0C', FONT.display, px(400))
        .setDepth(54));
    }

    /* Side by side, matching Pause and Level Complete. Two full-width keys
       stacked on top of each other was the odd one out on every other
       screen, and it pushed the lower one hard against the panel edge.
       TRY AGAIN takes the width as the primary action. */
    const gby = 862;  // panel ends at 959
    const retry = pill(this, W / 2 - px(112), px(gby), px(266), px(96), 'TRY AGAIN', px(26), 'green',
      () => { this.clearOverlay(); this.retryLevel(); }, 'lvIcReplay');
    const quit = pill(this, W / 2 + px(146), px(gby), px(186), px(88), 'MAP', px(24), 'cream',
      () => { this.clearOverlay(); this.scene.start('LevelSelect'); }, 'lvIcMap');
    [retry, quit].forEach((r) => {
      r.img.setDepth(52); r.txt.setDepth(54); items.push(r.img, r.txt, r.g);
    });
    this.overlay = items;
  }

  /* FIX 6: v1's retry called buildLevel() directly, which resets lives and
     levelScore but NOT RUN.score. A player could die, retry, die, retry -
     accumulating score the whole time - then clear the level once and bank
     an inflated personal best. Retrying now rewinds the run score by what
     this attempt contributed. */
  retryLevel() {
    RUN.score -= this.levelScore;
    if (RUN.score < 0) RUN.score = 0;
    this.buildLevel(this.levelIndex);
  }

  /* Entering a genuinely new level keeps the run score; only retries rewind. */
  startLevel(n) { this.buildLevel(n); }
}

/* ====================================================================
   Boot
   ==================================================================== */
/* Re-derive on a material viewport change: rotation, a desktop window
   drag, DevTools switching device. Debounced, and small changes are ignored
   - an Android URL bar collapsing would otherwise restart the scene
   mid-rally for a few pixels of height. */
function relayout(force) {
  const was = LH;
  measure();
  if (!force && Math.abs(LH - was) < 12) return false;

  const sm = window.game.scale;
  sm.setGameSize(W, H);
  /* setGameSize alone changed the canvas ATTRIBUTES but left the cached
     parent bounds in place, so the CSS size and centring offsets stayed
     fitted to the previous canvas - the canvas was the right shape and
     still drawn letterboxed, 137px down the screen. These two recompute
     the fit. */
  sm.updateBounds();
  sm.refresh();

  /* Every position was derived from the old H, so live scenes rebuild.
     Boot has finished and is not restarted. */
  window.game.scene.getScenes(true).forEach((sc) => sc.scene.restart());
  return true;
}

function installResizeWatch() {
  let timer = null;
  const onChange = () => { clearTimeout(timer); timer = setTimeout(() => relayout(false), 220); };
  window.addEventListener('resize', onChange);
  window.addEventListener('orientationchange', onChange);
  if (window.visualViewport) window.visualViewport.addEventListener('resize', onChange);

  /* An Android WebView frequently reports a stale viewport while loading -
     that is what made a 412x915 phone measure as landscape and drop LH to
     its 1400 floor. Re-check as layout settles; no resize event fires for
     this, so waiting on one is not enough.

     Bounded to the first correction. Each relayout rebuilds every live scene
     and re-bakes the backdrop (~67ms), so letting the poll fire repeatedly on
     a viewport that keeps twitching would stutter the whole boot. */
  let corrections = 0;
  [60, 200, 500, 1200, 2500].forEach((ms) => setTimeout(() => {
    if (corrections === 0 && relayout(false)) corrections++;
  }, ms));
}

window.addEventListener('load', function () {
  const l = document.getElementById('loading');
  if (l) l.style.display = 'none';
  /* Measure HERE, not at parse time. In a WebView - and under DevTools
     device emulation - innerWidth/innerHeight during parse can still be the
     pre-layout values, which made a 412x915 phone measure as landscape: LH
     fell to its 1400 floor, the canvas came out 1800x2800, and FIT
     letterboxed 137px off the top. */
  measure();
  window.game = new Phaser.Game({
    /* AUTO, not CANVAS. The canvas is 1800x3998 - 7.2 MEGAPIXELS - and
       software Canvas2D has to re-blit all of it every frame, which no phone
       CPU can do at 60fps; that is what made the paddle stutter. AUTO uses
       WebGL and hands the compositing to the GPU, and still falls back to
       Canvas2D on an old WebView that has no usable WebGL, so nothing is
       lost on the devices the original comment was worried about. */
    type: Phaser.AUTO,
    width: W,
    height: H,
    parent: 'wrap',
    backgroundColor: '#101f30',
    scale: { mode: Phaser.Scale.FIT, autoCenter: Phaser.Scale.CENTER_BOTH },
    physics: { default: 'arcade', arcade: { debug: false } },
    scene: [Boot, Home, LevelSelect, Shop, Play],
  });
  installResizeWatch();
  installFpsMeter();
});

/* Opt-in FPS readout: append ?fps=1 to the URL, or set
   localStorage['bb.fps'] = '1' (which survives into the packaged app, where
   there is no address bar to add a query string to).

   Exists because "it feels laggy" is unmeasurable by eye, and the usual place
   people check - a browser's device-emulation panel - is itself slow: it
   screencasts every frame and often drops to software compositing, so it
   reports a fraction of what the same build does on real hardware. This reads
   Phaser's own loop, so it tells you what the game is actually doing. */
function installFpsMeter() {
  let on = /[?&]fps=1/.test(location.search);
  try { on = on || window.localStorage.getItem('bb.fps') === '1'; } catch (e) {}
  if (!on) return;
  const d = document.createElement('div');
  d.style.cssText = 'position:fixed;top:0;left:0;z-index:99;padding:3px 7px;' +
    'font:600 12px/1.3 monospace;color:#0f0;background:rgba(0,0,0,.62);' +
    'pointer-events:none;white-space:pre;';
  document.body.appendChild(d);
  let worst = 0, frames = 0, over = 0, last = performance.now();
  const tick = () => {
    const now = performance.now(), dt = now - last; last = now;
    frames++;
    if (dt > 25) over++;
    if (dt > worst) worst = dt;
    if (frames % 15 === 0) {
      const g = window.game;
      const lines = [
        'fps ' + (g ? g.loop.actualFps.toFixed(0) : '?') +
          '  worst ' + worst.toFixed(0) + 'ms  janky ' + over + '/' + frames,
        (g && g.renderer.type === 2 ? 'WebGL' : 'Canvas2D') +
          ' ' + (g ? g.canvas.width + 'x' + g.canvas.height : '') +
          '  dpr ' + (window.devicePixelRatio || 1).toFixed(1),
      ];
      d.textContent = lines.join(String.fromCharCode(10));
      worst = 0;
    }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
}

</script>
</body>
</html>
