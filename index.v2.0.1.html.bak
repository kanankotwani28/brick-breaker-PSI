<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0a0d16">
<title>Brick Breaker</title>
<style>


*{margin:0;padding:0;box-sizing:border-box;}
/* touch-action:none is the responsiveness fix, not a nicety.

   With the default (auto) the browser holds each touch back while it decides
   whether the gesture is a scroll or a zoom, then often cancels the pointer
   sequence outright - so a tap on PLAY does nothing and a paddle drag scrolls
   the page instead of moving the paddle. none delivers pointerdown/move
   immediately and stops the browser competing for the gesture.

   overscroll-behavior kills pull-to-refresh, which otherwise fires on any
   downward swipe from the top of the play area. */
html,body,#wrap,#wrap canvas{
  touch-action:none;-ms-touch-action:none;overscroll-behavior:none;}
html,body{width:100%;height:100%;height:100dvh;margin:0;padding:0;background:#101f30;overflow:hidden;
  font-family:'RobotoCond',system-ui,sans-serif;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;}
#wrap{position:fixed;inset:0;height:100%;height:100dvh;width:100%;display:flex;align-items:center;justify-content:center;
  background:#101f30;overflow:hidden;}
/* Probe: the only way to read env() insets from script. Zero-sized and
   inert; the padding exists purely to be measured. */
#safe{position:fixed;top:0;left:0;width:0;height:0;pointer-events:none;
  padding-top:env(safe-area-inset-top,0px);
  padding-right:env(safe-area-inset-right,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  padding-left:env(safe-area-inset-left,0px);}
#wrap canvas{box-shadow:none;border-radius:0;display:block;}
#loading{position:fixed;inset:0;display:flex;flex-direction:column;gap:16px;
  align-items:center;justify-content:center;
  color:#93a3c4;font-size:14px;letter-spacing:.16em;background:#101f30;z-index:9;}
.spin-wrap{position:relative;width:68px;height:68px;}
.spin-wrap img{position:absolute;inset:0;width:100%;height:100%;}
.spin-wrap .spin-fg{animation:spin 1.1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
@font-face{font-family:'Baloo2XBold';font-display:block;src:url(data:font/ttf;base64,) format('truetype');}
@font-face{font-family:'LuckiestGuy';font-display:block;src:url(data:font/ttf;base64,) format('truetype');}
@font-face{font-family:'FredokaBold';font-display:block;src:url(data:font/ttf;base64,) format('truetype');}
@font-face{font-family:'FredokaMedium';font-display:block;src:url(data:font/ttf;base64,) format('truetype');}
</style>
</head>
<body>
<div id="wrap"></div>
<div id="safe"></div>
<div id="loading">
  <div class="spin-wrap">
    <img class="spin-bg" src="data:image/png;base64," alt="">
    <img class="spin-fg" src="data:image/png;base64," alt="">
  </div>
  <div>LOADING...</div>
</div>
